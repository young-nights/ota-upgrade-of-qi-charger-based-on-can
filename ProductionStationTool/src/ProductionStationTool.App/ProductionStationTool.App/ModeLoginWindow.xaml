<Window x:Class="ProductionStationTool.App.ModeLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录 — 产线测试上位机"
        MinWidth="460" SizeToContent="WidthAndHeight"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Border Style="{StaticResource Card}" Margin="20">
        <StackPanel>
            <TextBlock Text="选择登录身份" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="工位机：本机执行工位测试流程，免密码。汇总机：服务器电脑管理工位机接入与数据库，需管理密码。"
                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,6,0,16"/>

            <RadioButton x:Name="RdoStation" GroupName="Mode" IsChecked="True"
                         Content="工位机（工位测试，无需密码）" FontSize="14"
                         Checked="Mode_Checked"/>
            <RadioButton x:Name="RdoSummary" GroupName="Mode"
                         Content="汇总机（服务器管理，需密码）" FontSize="14"
                         Margin="0,10,0,0" Checked="Mode_Checked"/>

            <TextBlock Text="汇总机管理密码" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
            <PasswordBox x:Name="TxtPassword" Height="34" FontSize="15" IsEnabled="False"
                         VerticalContentAlignment="Center" Padding="8,4"
                         KeyDown="TxtPassword_KeyDown"/>

            <TextBlock x:Name="TxtMsg" Text="" FontSize="12"
                       Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="BtnLogin" Content="登录" Width="100" Height="34"
                        Style="{StaticResource PrimaryButton}" Click="BtnLogin_Click"/>
                <Button Content="取消" Width="100" Height="34" Margin="10,0,0,0"
                        Style="{StaticResource GhostButton}" Click="BtnCancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
