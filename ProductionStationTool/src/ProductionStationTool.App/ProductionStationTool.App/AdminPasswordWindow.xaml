<Window x:Class="ProductionStationTool.App.AdminPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="管理密码验证" Width="440" MinHeight="240" SizeToContent="Height"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Border Style="{StaticResource Card}" Margin="16">
        <StackPanel>
            <TextBlock Text="管理密码验证" Style="{StaticResource SectionTitle}"/>
            <TextBlock x:Name="TxtPurpose" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,2,0,12"/>

            <TextBlock Text="汇总机管理密码" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="TxtPassword" Height="34" FontSize="15"
                         VerticalContentAlignment="Center" Padding="8,4"
                         KeyDown="TxtPassword_KeyDown"/>

            <TextBlock x:Name="TxtMsg" Text="" FontSize="12"
                       Foreground="{StaticResource DangerBrush}" Margin="0,8,0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="确定" Width="90" Height="34"
                        Style="{StaticResource PrimaryButton}" Click="BtnOk_Click"/>
                <Button Content="取消" Width="90" Height="34" Margin="10,0,0,0"
                        Style="{StaticResource GhostButton}" Click="BtnCancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
