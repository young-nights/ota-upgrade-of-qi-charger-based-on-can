<Window x:Class="ProductionStationTool.App.SummaryPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修改汇总机密码" Height="300" Width="440"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Border Style="{StaticResource Card}" Margin="16">
        <StackPanel>
            <TextBlock Text="修改汇总机管理密码" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="machine.json 只存 SHA-256 哈希，修改后下次进入汇总机生效"
                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,2,0,12"/>

            <TextBlock Text="旧密码" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="TxtOldPw" Height="30" FontSize="14"
                         VerticalContentAlignment="Center" Padding="8,4" Margin="0,0,0,8"/>

            <TextBlock Text="新密码（至少 6 位）" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="TxtNewPw" Height="30" FontSize="14"
                         VerticalContentAlignment="Center" Padding="8,4" Margin="0,0,0,8"/>

            <TextBlock Text="确认新密码" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="TxtNewPw2" Height="30" FontSize="14"
                         VerticalContentAlignment="Center" Padding="8,4" Margin="0,0,0,8"/>

            <TextBlock x:Name="TxtMsg" Text="" FontSize="12"
                       Foreground="{StaticResource DangerBrush}" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnSave" Content="保存" Width="90" Height="32"
                        Style="{StaticResource PrimaryButton}" Click="BtnSave_Click"/>
                <Button Content="取消" Width="90" Height="32" Margin="10,0,0,0"
                        Style="{StaticResource GhostButton}" Click="BtnCancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
