<Window x:Class="ProductionStationTool.App.SummaryLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="进入汇总机"
        MinWidth="440" SizeToContent="WidthAndHeight"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Border Style="{StaticResource Card}" Margin="16">
        <StackPanel>
            <TextBlock Text="输入管理密码以进入汇总机" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="汇总机页用于服务器电脑管理工位机接入与数据库表格"
                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,4,0,14" TextWrapping="Wrap"/>
            <PasswordBox x:Name="TxtPassword" Height="34" FontSize="15"
                         VerticalContentAlignment="Center" Padding="8,4"
                         KeyDown="TxtPassword_KeyDown"/>
            <TextBlock x:Name="TxtMsg" Text="" FontSize="12"
                       Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="BtnEnter" Content="进入" Width="90" Height="32"
                        Style="{StaticResource PrimaryButton}" Click="BtnEnter_Click"/>
                <Button Content="取消" Width="90" Height="32" Margin="10,0,0,0"
                        Style="{StaticResource GhostButton}" Click="BtnCancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
