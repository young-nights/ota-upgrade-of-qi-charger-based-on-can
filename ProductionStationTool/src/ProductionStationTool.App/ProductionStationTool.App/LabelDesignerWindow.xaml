<Window x:Class="ProductionStationTool.App.LabelDesignerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="打印机设置 — SN 码标签设计" Height="860" Width="880"
        MinWidth="720" MinHeight="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        WindowState="Maximized"
        Background="{StaticResource BgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
        <StackPanel Margin="16">

            <!-- 画布 + 标签尺寸 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="标签尺寸与画布" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="画布 = 参数所附着的 .btw 骨架（默认取内置 SN 码模板）。在这里直接设置标签尺寸与打印机参数，「生成」时把参数写进输出模板——不需要手工在 BarTender 里导入导出。"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,10,0,12"/>

                    <TextBlock Text="画布模板（.btw）" Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="BoxCanvas" Grid.Column="0" Style="{StaticResource FieldBox}"
                                 Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="浏览…" Width="90" Height="36"
                                Style="{StaticResource GhostButton}" Click="BtnBrowseCanvas_Click"/>
                    </Grid>

                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,8,0" ToolTip="标签宽度（毫米）">
                            <TextBlock Text="标签宽 (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="BoxWidthMm" Style="{StaticResource FieldBox}" Text="50"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0" ToolTip="标签高度（毫米）">
                            <TextBlock Text="标签高 (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="BoxHeightMm" Style="{StaticResource FieldBox}" Text="30"/>
                        </StackPanel>
                        <StackPanel ToolTip="纸张高度（毫米）；0 = 跟随标签高">
                            <TextBlock Text="纸高 (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="BoxPaperMm" Style="{StaticResource FieldBox}" Text="0"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- 打印机参数 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="打印机参数" Style="{StaticResource SectionTitle}"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="打印机" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="ComboPrinter" Height="36" Style="{StaticResource FieldComboEditable}"
                                      IsEditable="True"
                                      ToolTip="目标打印机（本机打印机列表可点「刷新」枚举，也可直接手填打印机名）"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="刷新" Width="80" Height="36" VerticalAlignment="Bottom"
                                Style="{StaticResource GhostButton}" Click="BtnRefreshPrinters_Click"/>
                        <StackPanel Grid.Column="3"
                                    ToolTip="份数：一次打印任务里连续出几张相同的标签（1 = 出一张）">
                            <TextBlock Text="份数" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="BoxCopies" Style="{StaticResource FieldBox}" Text="1"/>
                        </StackPanel>
                        <StackPanel Grid.Column="5"
                                    ToolTip="速度：打印机走纸/打印速度档位（数值越大越快）；0 = 用打印机当前默认，部分驱动不支持从软件设置">
                            <TextBlock Text="速度" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="BoxSpeed" Style="{StaticResource FieldBox}" Text="0"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <StackPanel Width="110" Margin="0,0,8,0"
                                    ToolTip="浓度：打印黑度/深浅（数值越大越黑，条码对比度更高）；0 = 用打印机当前默认，部分驱动不支持从软件设置">
                            <TextBlock Text="浓度" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="BoxDarkness" Style="{StaticResource FieldBox}" Text="0"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="份数 = 一次任务出几张相同标签；速度 = 走纸/打印快慢档位（越大越快）；浓度 = 打印黑度（越大越黑）。速度/浓度填 0 表示用打印机默认——这两项是驱动相关参数，部分打印机不支持从软件设置，生成时会提示「未支持」。"
                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- 对象排版 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="对象排版（文本/字体/位置）" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="从画布读取对象后逐个调整：文本内容支持 {SN} 占位（须为命名数据源，打印时替换）；字体/字号/粗体/坐标 单位 mm，留空/0 表示不改画布原值。"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,10,0,12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="从画布读取对象" Width="150" Height="36"
                                Style="{StaticResource GhostButton}" Click="BtnReadObjects_Click"
                                ToolTip="经 BarTender 读取画布内对象的名称/字体/字号/坐标（需本机装 BarTender）"/>
                        <TextBlock x:Name="TxtObjStatus" VerticalAlignment="Center"
                                   Margin="12,0,0,0" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <DataGrid x:Name="GridObjects" AutoGenerateColumns="False" IsReadOnly="False"
                              SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              MaxHeight="220" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="对象" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="文本内容（{SN}）" Binding="{Binding Content}" Width="170"/>
                            <DataGridTextColumn Header="字体" Binding="{Binding FontName}" Width="100"/>
                            <DataGridTextColumn Header="字号" Binding="{Binding FontSizePt}" Width="56"/>
                            <DataGridCheckBoxColumn Header="粗体" Binding="{Binding Bold, UpdateSourceTrigger=PropertyChanged}" Width="52"/>
                            <DataGridTextColumn Header="X(mm)" Binding="{Binding XMm}" Width="64"/>
                            <DataGridTextColumn Header="Y(mm)" Binding="{Binding YMm}" Width="64"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- 生成与打印 -->
            <StackPanel Orientation="Horizontal">
                <Button Content="生成 .btw" Width="130" Height="40"
                        Style="{StaticResource PrimaryButton}" Click="BtnGenerate_Click"
                        ToolTip="把全部参数应用到画布副本并保存为输出模板"/>
                <Button Content="试打印一张" Width="120" Height="40" Margin="12,0,0,0"
                        Style="{StaticResource GhostButton}" Click="BtnTestPrint_Click"
                        ToolTip="先生成，再以 {SN}=TEST0001 试打一张"/>
                <Button Content="保存并应用" Width="130" Height="40" Margin="12,0,0,0"
                        Style="{StaticResource GhostButton}" Click="BtnSave_Click"
                        ToolTip="生成 + 保存设计与打印预设（machine.json），工位4 打印按此出标签"/>
            </StackPanel>
            <TextBlock x:Name="TxtResult" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>
    </ScrollViewer>
</Window>
