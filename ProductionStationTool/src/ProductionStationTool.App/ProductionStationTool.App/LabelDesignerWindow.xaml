<Window x:Class="ProductionStationTool.App.LabelDesignerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="打印机设置 — SN 码标签设计" Height="860" Width="880"
        MinWidth="720" MinHeight="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        WindowState="Maximized"
        Background="{StaticResource BgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
        <StackPanel Margin="16">

            <!-- 标签尺寸 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="标签尺寸" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="在这里直接配置标签尺寸、打印机参数与排版，打印时按 TSPL/ZPL 指令直发打印机——不需要 BarTender，也没有授权限制。"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,10,0,12"/>
                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,8,0" ToolTip="标签宽度（毫米）">
                            <TextBlock Text="标签宽 (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="BoxWidthMm" Style="{StaticResource FieldBox}" Text="50"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0" ToolTip="标签高度（毫米）">
                            <TextBlock Text="标签高 (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="BoxHeightMm" Style="{StaticResource FieldBox}" Text="30"/>
                        </StackPanel>
                        <StackPanel ToolTip="纸张高度（毫米）；0 = 跟随标签高">
                            <TextBlock Text="纸高 (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="BoxPaperMm" Style="{StaticResource FieldBox}" Text="0"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- 打印机参数 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="打印机参数" Style="{StaticResource SectionTitle}"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="打印机" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="ComboPrinter" Height="36" Style="{StaticResource FieldCombo}"
                                      ToolTip="目标打印机（点「刷新」枚举本机打印机，下拉选择）"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="刷新" Width="80" Height="36" VerticalAlignment="Bottom"
                                Style="{StaticResource GhostButton}" Click="BtnRefreshPrinters_Click"/>
                        <StackPanel Grid.Column="3"
                                    ToolTip="份数：一次打印任务里连续出几张相同的标签（1 = 出一张）">
                            <TextBlock Text="份数" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="BoxCopies" Style="{StaticResource FieldBox}" Text="1"/>
                        </StackPanel>
                        <StackPanel Grid.Column="5"
                                    ToolTip="速度：打印机走纸/打印速度档位（数值越大越快）；0 = 用打印机当前默认">
                            <TextBlock Text="速度" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="BoxSpeed" Style="{StaticResource FieldBox}" Text="0"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <StackPanel Width="110" Margin="0,0,8,0"
                                    ToolTip="浓度：打印黑度/深浅（数值越大越黑，条码对比度更高）；0 = 用打印机当前默认">
                            <TextBlock Text="浓度" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="BoxDarkness" Style="{StaticResource FieldBox}" Text="0"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="份数 = 一次任务出几张相同标签；速度 = 走纸/打印快慢档位（越大越快）；浓度 = 打印黑度（越大越黑）。速度/浓度填 0 表示用打印机默认。"
                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,10,0,10"/>

                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,8,0"
                                    ToolTip="直驱指令语言：TSPL = TSC 及兼容机（中文 TTF 友好）；ZPL = Zebra（中文需亚洲字库）">
                            <TextBlock Text="指令语言" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="ComboScript" Height="36" Style="{StaticResource FieldCombo}">
                                <ComboBoxItem Content="TSPL（TSC 兼容）" IsSelected="True"/>
                                <ComboBoxItem Content="ZPL（Zebra）"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0" ToolTip="打印机分辨率（dpi），203 最常见，300 用于高密度标签">
                            <TextBlock Text="分辨率" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="ComboDpi" Height="36" Style="{StaticResource FieldCombo}">
                                <ComboBoxItem Content="203 dpi" IsSelected="True"/>
                                <ComboBoxItem Content="300 dpi"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel ToolTip="标签间隙（mm）：标签纸相邻两张之间的空隙；0 = 连续纸">
                            <TextBlock Text="间距 (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="BoxGapMm" Style="{StaticResource FieldBox}" Text="2"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- 条码设置 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="条码（Code128）" Style="{StaticResource SectionTitle}"/>
                    <CheckBox x:Name="ChkBarcode" Content="启用条码" IsChecked="True"
                              FontSize="13" Margin="0,10,0,10"/>
                    <UniformGrid Columns="4">
                        <StackPanel Margin="0,0,8,0" ToolTip="条码内容，支持 {SN} 占位（打印时替换为实际 SN）">
                            <TextBlock Text="内容" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="BoxBcContent" Style="{StaticResource FieldBox}" Text="{}{SN}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0" ToolTip="条码高度（mm）">
                            <TextBlock Text="高度 (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="BoxBcHeight" Style="{StaticResource FieldBox}" Text="8"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0" ToolTip="条码模块（窄条）宽度（mm），越小越密">
                            <TextBlock Text="模块宽 (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="BoxBcModule" Style="{StaticResource FieldBox}" Text="0.4"/>
                        </StackPanel>
                        <StackPanel ToolTip="条码下方是否显示可读字符">
                            <TextBlock Text="人读字符" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="ComboBcHuman" Height="36" Style="{StaticResource FieldCombo}">
                                <ComboBoxItem Content="显示" IsSelected="True"/>
                                <ComboBoxItem Content="不显示"/>
                            </ComboBox>
                        </StackPanel>
                    </UniformGrid>
                    <UniformGrid Columns="2" Margin="0,10,0,0">
                        <StackPanel Margin="0,0,8,0" ToolTip="条码左上角 X 坐标（mm）">
                            <TextBlock Text="X (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="BoxBcX" Style="{StaticResource FieldBox}" Text="5"/>
                        </StackPanel>
                        <StackPanel ToolTip="条码左上角 Y 坐标（mm）">
                            <TextBlock Text="Y (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="BoxBcY" Style="{StaticResource FieldBox}" Text="15"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- 文字排版 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="文字排版" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="逐行配置文字：文本内容支持 {SN} 占位（打印时替换）；字体（如 SimSun/Arial）、字号 pt、坐标 mm。"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,10,0,12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="添加行" Width="90" Height="36"
                                Style="{StaticResource GhostButton}" Click="BtnAddRow_Click"/>
                        <Button Content="删除行" Width="90" Height="36" Margin="8,0,0,0"
                                Style="{StaticResource GhostButton}" Click="BtnDelRow_Click"
                                ToolTip="删除选中行"/>
                        <TextBlock x:Name="TxtObjStatus" VerticalAlignment="Center"
                                   Margin="12,0,0,0" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <DataGrid x:Name="GridObjects" AutoGenerateColumns="False" IsReadOnly="False"
                              SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              MaxHeight="220" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="行名" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="文本内容（{SN}）" Binding="{Binding Content}" Width="190"/>
                            <DataGridTextColumn Header="字体" Binding="{Binding FontName}" Width="100"/>
                            <DataGridTextColumn Header="字号" Binding="{Binding FontSizePt}" Width="56"/>
                            <DataGridCheckBoxColumn Header="粗体" Binding="{Binding Bold, UpdateSourceTrigger=PropertyChanged}" Width="52"/>
                            <DataGridTextColumn Header="X(mm)" Binding="{Binding XMm}" Width="64"/>
                            <DataGridTextColumn Header="Y(mm)" Binding="{Binding YMm}" Width="64"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- 打印与保存 -->
            <StackPanel Orientation="Horizontal">
                <Button Content="试打印一张" Width="130" Height="40"
                        Style="{StaticResource PrimaryButton}" Click="BtnTestPrint_Click"
                        ToolTip="按当前配置直驱出一张（SN 代入 TEST0001）"/>
                <Button Content="查看打印指令" Width="130" Height="40" Margin="12,0,0,0"
                        Style="{StaticResource GhostButton}" Click="BtnShowScript_Click"
                        ToolTip="显示将下发的 TSPL/ZPL 指令（便于核对，不需要打印机）"/>
                <Button Content="保存" Width="110" Height="40" Margin="12,0,0,0"
                        Style="{StaticResource GhostButton}" Click="BtnSave_Click"
                        ToolTip="保存设计（machine.json），工位 4 打印按此出标签"/>
            </StackPanel>
            <TextBlock x:Name="TxtResult" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
            <TextBox x:Name="BoxScript" Style="{StaticResource FieldBox}" Height="140"
                     Margin="0,10,0,0" IsReadOnly="True" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                     Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</Window>
