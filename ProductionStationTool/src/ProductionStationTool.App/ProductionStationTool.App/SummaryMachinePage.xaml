<UserControl x:Class="ProductionStationTool.App.SummaryMachinePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!-- 顶部横幅（与主页面同款）：设置（汇总机独立）。身份仅启动登录时选定，无退出按钮 -->
        <Border DockPanel.Dock="Top" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1"
                Padding="12,2">
            <Grid>
                <Menu Background="Transparent" FontSize="14">
                    <MenuItem Header="设置">
                        <MenuItem Header="设置汇总机密码…" Click="MenuSetPassword_Click"/>
                    </MenuItem>
                </Menu>
            </Grid>
        </Border>

        <!-- 状态栏（与主页面同款） -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0" Width="10" Height="10"
                         Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtStatusSummary" Grid.Column="1" Margin="8,0,0,0"
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                           Text="汇总机：管理工位机接入与数据库表格"/>
                <TextBlock Grid.Column="2" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="ProductionStationTool"/>
            </Grid>
        </Border>

        <!-- 主体：左功能选择 + 右操作栏/内容宿主 -->
        <Grid x:Name="MgmtPanel" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：功能选择（与主页面「工位选择」同款） -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="功能选择" Style="{StaticResource SectionTitle}"
                               Margin="0,0,0,12"/>
                    <TextBlock DockPanel.Dock="Top"
                               Text="汇总机两个管理功能，点击切换页面"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,12" TextWrapping="Wrap"/>
                    <ListBox x:Name="ListFunctions" FontSize="16"
                             SelectedIndex="0"
                             Background="Transparent" BorderThickness="0"
                             SelectionChanged="ListFunctions_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="14,12"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" CornerRadius="8"
                                                    Background="#F8FAFC"
                                                    BorderBrush="#E2E8F0" BorderThickness="1"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#EFF6FF"/>
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#93C5FD"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#2563EB"/>
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#2563EB"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBoxItem Content="工位机接入管理"/>
                        <ListBoxItem Content="数据库表格"/>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 右：操作栏 + 功能页面宿主 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 顶部操作栏 -->
                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtSectionTitle" Text="工位机接入管理"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="TxtSectionDesc"
                                       Text="登记各工位机的编码、IP 与接入权限，并汇总各机位测试概况"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button x:Name="BtnRefreshDb" Grid.Column="1" Content="刷新表格" Height="40" Padding="18,0"
                                FontSize="15" Style="{StaticResource GhostButton}"
                                Visibility="Collapsed" Click="BtnRefreshDb_Click"
                                ToolTip="按当前筛选条件重新查询 test_records"/>
                    </Grid>
                </Border>

                <!-- 功能页面宿主 -->
                <Grid Grid.Row="2">
                    <!-- 页 1：工位机接入管理 -->
                    <Border x:Name="PanelAccess" Style="{StaticResource Card}">
                        <DockPanel>
                            <!-- 概况行 -->
                            <TextBlock x:Name="TxtStationSummary" DockPanel.Dock="Top"
                                       FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <!-- 工位机状态卡片：接入后按 IP 自动登记，无需手动录入 -->
                            <TextBlock DockPanel.Dock="Top" Text="工位机状态（接入后自动生成）"
                                       Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ItemsMachines">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border MinWidth="230" Margin="0,0,10,10" Padding="14">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="8"/>
                                                        <Setter Property="Background" Value="#F8FAFC"/>
                                                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Online}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#16A34A"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}" FontSize="14"
                                                               FontWeight="SemiBold" Foreground="#0F172A"/>
                                                    <TextBlock FontSize="11" Foreground="#64748B" Margin="0,2,0,0">
                                                        <Run Text="编码 "/><Run Text="{Binding Code}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="12" FontFamily="Consolas"
                                                               Foreground="#0F172A" Margin="0,4,0,0">
                                                        <Run Text="IP "/><Run Text="{Binding Ip}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="12"
                                                               FontWeight="SemiBold" Margin="0,4,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#64748B"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Online}" Value="True">
                                                                        <Setter Property="Foreground" Value="#16A34A"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding LastSeenText}" FontSize="11"
                                                               Foreground="#64748B"/>
                                                    <TextBlock Text="{Binding StatsText}" FontSize="11"
                                                               Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                        <Button Content="{Binding AllowedText}" Tag="{Binding Code}"
                                                                Height="30" Padding="12,2" FontSize="12"
                                                                Style="{StaticResource GhostButton}"
                                                                Click="CardToggle_Click"
                                                                ToolTip="允许/禁止该工位机接入"/>
                                                        <Button Content="移除" Tag="{Binding Code}"
                                                                Height="30" Padding="12,2" FontSize="12"
                                                                Margin="8,0,0,0" Style="{StaticResource GhostButton}"
                                                                Click="CardRemove_Click"
                                                                ToolTip="移除该工位机记录（再次接入会自动重建）"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- 页 2：数据库表格（筛选 + 记录表） -->
                    <Border x:Name="PanelRecords" Style="{StaticResource Card}" Visibility="Collapsed">
                        <DockPanel>
                            <!-- 筛选栏：时间 / 机位 / 工位 / 结果（机位号在工位号左边，纯数字） -->
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="时间起" Style="{StaticResource FieldLabel}"/>
                                    <DatePicker x:Name="PickFrom" Width="135" Height="36"/>
                                </StackPanel>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Text="时间止" Style="{StaticResource FieldLabel}"/>
                                    <DatePicker x:Name="PickTo" Width="135" Height="36"/>
                                </StackPanel>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Text="机位" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="ComboMachine" Width="105" Height="36"
                                              Style="{StaticResource FieldCombo}"/>
                                </StackPanel>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Text="工位" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="ComboStation" Width="105" Height="36"
                                              Style="{StaticResource FieldCombo}"/>
                                </StackPanel>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Text="结果" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="ComboResult" Width="105" Height="36"
                                              Style="{StaticResource FieldCombo}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,0">
                                    <Button x:Name="BtnQuery" Content="查询" Height="40" Padding="18,4"
                                            Style="{StaticResource PrimaryButton}" Click="BtnQuery_Click"
                                            ToolTip="按当前筛选条件查询 test_records"/>
                                    <Button x:Name="BtnResetFilter" Content="重置" Height="40" Padding="18,4"
                                            Margin="8,0,0,0" Style="{StaticResource GhostButton}"
                                            Click="BtnResetFilter_Click"
                                            ToolTip="清空全部筛选条件并重新查询"/>
                                </StackPanel>
                            </WrapPanel>
                            <!-- 统计行 -->
                            <TextBlock x:Name="TxtDbStats" DockPanel.Dock="Top" Margin="0,0,0,8"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <!-- 记录表：结果绿/红，工位/机位纯数字 -->
                            <DataGrid x:Name="GridRecords" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      FontSize="12">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="46"/>
                                    <DataGridTextColumn Header="SN" Binding="{Binding Sn}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="工位" Binding="{Binding StationNo}" Width="52"/>
                                    <DataGridTextColumn Header="机位" Binding="{Binding MachineId}" Width="52"/>
                                    <DataGridTemplateColumn Header="结果" Width="56">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Result}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#64748B"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Result}" Value="PASS">
                                                                    <Setter Property="Foreground" Value="#16A34A"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Result}" Value="FAIL">
                                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="电压" Binding="{Binding Voltage, StringFormat=F3}" Width="58"/>
                                    <DataGridTextColumn Header="电流" Binding="{Binding Current, StringFormat=F3}" Width="58"/>
                                    <DataGridTextColumn Header="异常项" Binding="{Binding AbnormalItems}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="测试时间" Binding="{Binding TestTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="130"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
