<UserControl x:Class="ProductionStationTool.App.SummaryMachinePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!-- 顶部横幅（与主页面同款）：下拉菜单 + 退出汇总机 -->
        <Border DockPanel.Dock="Top" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1"
                Padding="12,2">
            <Grid>
                <Menu Background="Transparent" FontSize="14">
                    <MenuItem Header="设置">
                        <MenuItem Header="机位与网络…" Click="MenuSettingsNetwork_Click"/>
                        <MenuItem Header="检测参数…" Click="MenuSettingsCoil_Click"/>
                        <MenuItem Header="修改汇总机密码…" Click="MenuChangePassword_Click"/>
                    </MenuItem>
                    <MenuItem Header="关于">
                        <MenuItem Header="关于 ProductionStationTool…" Click="MenuAbout_Click"/>
                    </MenuItem>
                </Menu>
                <Button x:Name="BtnExit" Content="退出汇总机" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Height="32" Padding="18,0"
                        Style="{StaticResource PrimaryButton}" Click="BtnExit_Click"
                        ToolTip="返回工位机工作区（下次进入需重新输密码）"/>
            </Grid>
        </Border>

        <!-- 状态栏（与主页面同款） -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0" Width="10" Height="10"
                         Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtStatusSummary" Grid.Column="1" Margin="8,0,0,0"
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                           Text="汇总机：请输入管理密码进入管理区"/>
                <TextBlock Grid.Column="2" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="ProductionStationTool"/>
            </Grid>
        </Border>

        <!-- 密码门（锁定态）：输对密码才进管理区 -->
        <Border x:Name="LockPanel">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="输入管理密码以进入汇总机" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="汇总机页用于服务器电脑管理工位机接入与数据库表格"
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,6,0,18"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <PasswordBox x:Name="TxtPassword" Width="240" Height="36" FontSize="15"
                                 VerticalContentAlignment="Center" Padding="8,4"
                                 KeyDown="TxtPassword_KeyDown"/>
                    <Button x:Name="BtnUnlock" Content="进入汇总机" Margin="10,0,0,0"
                            Height="36" Padding="18,0" FontSize="15"
                            Style="{StaticResource PrimaryButton}"
                            Click="BtnUnlock_Click"/>
                </StackPanel>
                <TextBlock x:Name="TxtLockMsg" Text="" FontSize="13" Foreground="{StaticResource DangerBrush}"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- 主体（解锁态）：左功能选择 + 右操作栏/内容宿主 -->
        <Grid x:Name="MgmtPanel" Margin="16" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：功能选择（与主页面「工位选择」同款） -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="功能选择" Style="{StaticResource SectionTitle}"
                               Margin="0,0,0,12"/>
                    <TextBlock DockPanel.Dock="Top"
                               Text="汇总机两个管理功能，点击切换页面"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,12" TextWrapping="Wrap"/>
                    <ListBox x:Name="ListFunctions" FontSize="16"
                             SelectedIndex="0"
                             Background="Transparent" BorderThickness="0"
                             SelectionChanged="ListFunctions_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="14,12"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" CornerRadius="8"
                                                    Background="#F8FAFC"
                                                    BorderBrush="#E2E8F0" BorderThickness="1"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#EFF6FF"/>
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#93C5FD"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#2563EB"/>
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#2563EB"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBoxItem Content="工位机接入管理"/>
                        <ListBoxItem Content="数据库表格"/>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 右：操作栏 + 功能页面宿主 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 顶部操作栏 -->
                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtSectionTitle" Text="工位机接入管理"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="TxtSectionDesc"
                                       Text="维护允许接入服务器的工位机清单（编码如 ST-01-1）"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnRefreshDb" Content="刷新表格" Height="40" Padding="18,0"
                                    FontSize="15" Style="{StaticResource GhostButton}"
                                    Visibility="Collapsed" Click="BtnRefreshDb_Click"
                                    ToolTip="重新加载 station_records.db · test_records"/>
                            <Button x:Name="BtnShowAll" Content="显示全部机位" Height="40" Padding="18,0"
                                    FontSize="15" Margin="10,0,0,0" Style="{StaticResource GhostButton}"
                                    Visibility="Collapsed" Click="BtnShowAll_Click"
                                    ToolTip="取消机位筛选，显示全部记录"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 功能页面宿主 -->
                <Grid Grid.Row="2">
                    <!-- 页 1：工位机接入管理 -->
                    <Border x:Name="PanelAccess" Style="{StaticResource Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBox x:Name="TxtNewCode" Width="110" Height="30" Style="{StaticResource FieldBox}"
                                         ToolTip="工位机编码，如 ST-01-1"/>
                                <TextBox x:Name="TxtNewNote" Width="150" Height="30" Margin="8,0,0,0"
                                         Style="{StaticResource FieldBox}" ToolTip="备注（可空）"/>
                                <Button x:Name="BtnAddStation" Content="添加" Margin="8,0,0,0" Height="30"
                                        Style="{StaticResource PrimaryButton}" Click="BtnAddStation_Click"/>
                                <Button x:Name="BtnRemoveStation" Content="移除" Margin="8,0,0,0" Height="30"
                                        Style="{StaticResource GhostButton}" Click="BtnRemoveStation_Click"
                                        ToolTip="移除选中的工位机登记"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button x:Name="BtnAllow" Content="允许接入" Height="30"
                                        Style="{StaticResource GhostButton}" Click="BtnAllow_Click"
                                        ToolTip="选中的工位机允许接入服务器"/>
                                <Button x:Name="BtnDeny" Content="禁止接入" Margin="8,0,0,0" Height="30"
                                        Style="{StaticResource GhostButton}" Click="BtnDeny_Click"
                                        ToolTip="选中的工位机禁止接入服务器"/>
                                <TextBlock x:Name="TxtStationMsg" VerticalAlignment="Center" Margin="12,0,0,0"
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <DataGrid x:Name="GridStations" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      FontSize="13" RowHeight="30">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="编码" Binding="{Binding Code}" Width="110"/>
                                    <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="*"/>
                                    <DataGridCheckBoxColumn Header="接入" Binding="{Binding Allowed}" Width="60"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <!-- 页 2：数据库表格（机位概览 + 记录表） -->
                    <Border x:Name="PanelRecords" Style="{StaticResource Card}" Visibility="Collapsed">
                        <DockPanel>
                            <!-- 机位概览：一机位一卡，绿=最近 PASS / 红=最近 FAIL / 灰=未测试 -->
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="机位概览" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="每个机位一张卡片，一眼看清该机位下最近测试 PASS/FAIL；点击卡片筛选下方表格"
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,2,0,8" TextWrapping="Wrap"/>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="ItemsMachines">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Tag="{Binding Code}" Cursor="Hand"
                                                        MouseLeftButtonUp="MachineCard_Click"
                                                        MinWidth="150" Margin="0,0,8,8">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#F1F5F9"/>
                                                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Setter Property="CornerRadius" Value="8"/>
                                                            <Setter Property="Padding" Value="12,8"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="PASS">
                                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                                    <Setter Property="BorderBrush" Value="#16A34A"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="FAIL">
                                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                                    <Setter Property="BorderBrush" Value="#DC2626"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="#2563EB"/>
                                                                    <Setter Property="BorderThickness" Value="2"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Label}" FontSize="13"
                                                                   FontWeight="SemiBold" Foreground="#0F172A"/>
                                                        <TextBlock Text="{Binding Status}" FontSize="16"
                                                                   FontWeight="Bold" Margin="0,2,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#64748B"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="PASS">
                                                                            <Setter Property="Foreground" Value="#16A34A"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="FAIL">
                                                                            <Setter Property="Foreground" Value="#DC2626"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Code}" FontSize="11"
                                                                   Foreground="#64748B" Margin="0,2,0,0"/>
                                                        <TextBlock Text="{Binding Counts}" FontSize="11"
                                                                   Foreground="#64748B"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                            <!-- 统计行 -->
                            <TextBlock x:Name="TxtDbStats" DockPanel.Dock="Top" Margin="0,0,0,8"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <!-- 记录表：按机位分组排序，结果绿/红 -->
                            <DataGrid x:Name="GridRecords" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      FontSize="12" RowHeight="26">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="46"/>
                                    <DataGridTextColumn Header="SN" Binding="{Binding Sn}" Width="*"/>
                                    <DataGridTextColumn Header="机位" Binding="{Binding Code}" Width="90"/>
                                    <DataGridTemplateColumn Header="结果" Width="56">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Result}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#64748B"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Result}" Value="PASS">
                                                                    <Setter Property="Foreground" Value="#16A34A"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Result}" Value="FAIL">
                                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="电压" Binding="{Binding Voltage, StringFormat=F3}" Width="60"/>
                                    <DataGridTextColumn Header="电流" Binding="{Binding Current, StringFormat=F3}" Width="60"/>
                                    <DataGridTextColumn Header="异常项" Binding="{Binding AbnormalItems}" Width="*"/>
                                    <DataGridTextColumn Header="测试时间" Binding="{Binding TestTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="130"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
