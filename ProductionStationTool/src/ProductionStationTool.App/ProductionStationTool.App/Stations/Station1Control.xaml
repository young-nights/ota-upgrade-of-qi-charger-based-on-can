<UserControl x:Class="ProductionStationTool.App.Stations.Station1Control"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ProductionStationTool.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="220"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="150" MinHeight="80"/>
        </Grid.RowDefinitions>

        <!-- ① 串口接入区 -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <controls:ConnectionPanel x:Name="ConnPanel"/>
        </Border>

        <!-- ② 流程区 + ③ 数据展示区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 流程区 -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="测试流程" Style="{StaticResource SectionTitle}"
                               Margin="0,0,0,12"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <controls:FlowStepsPanel x:Name="FlowPanel"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 数据展示区 -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="数据展示" Style="{StaticResource SectionTitle}"/>

                        <!-- 结果大字 -->
                        <Border x:Name="BadgeResult" Background="#F1F5F9" CornerRadius="8"
                                Padding="24,12" Margin="0,12,0,16" HorizontalAlignment="Left">
                            <TextBlock x:Name="TxtResult" Text="待测试" FontSize="44"
                                       FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>

                        <!-- SN / 判定 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource FieldBgBrush}"
                                    CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="SN 码" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="TxtSn" Text="—"
                                               FontSize="18" FontWeight="SemiBold" FontFamily="Consolas"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{StaticResource FieldBgBrush}"
                                    CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="线圈判定（A/B）" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="TxtPowerJudge" Text="—"
                                               FontSize="18" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 电压 / 电流 大数 -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource FieldBgBrush}"
                                    CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="电压 (V)" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="TxtVoltage" Text="—"
                                               FontSize="32" FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{StaticResource FieldBgBrush}"
                                    CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="电流 (A)" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="TxtCurrent" Text="—"
                                               FontSize="32" FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 线圈检测参数 -->
                        <TextBlock Text="线圈检测参数（可现场修改）" Style="{StaticResource SectionTitle}"
                                   Margin="0,0,0,8"/>
                        <UniformGrid Columns="5">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="A 阈值 (A)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="BoxAThreshold" Style="{StaticResource FieldBox}" Text="1.0"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="B 阈值 (A)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="BoxBThreshold" Style="{StaticResource FieldBox}" Text="1.0"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="A 窗口 (s)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="BoxAWindowSec" Style="{StaticResource FieldBox}" Text="10"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="B 持续 (s)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="BoxBSustainSec" Style="{StaticResource FieldBox}" Text="3"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="整体超时 (s)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="BoxTimeoutSec" Style="{StaticResource FieldBox}" Text="60"/>
                            </StackPanel>
                        </UniformGrid>

                        <!-- 异常项 -->
                        <TextBlock Text="异常项" Style="{StaticResource SectionTitle}" Margin="0,16,0,8"/>
                        <ListBox x:Name="ListAbnormal" FontSize="14" MinHeight="60"
                                 Background="{StaticResource FieldBgBrush}"
                                 BorderBrush="{StaticResource CardBorderBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 拖拽分隔条：上拉扩大日志区，上部区域同步缩小（实时拖动，无预览框） -->
        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch"
                      VerticalAlignment="Center" ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      Background="#E2E8F0" ShowsPreview="False" Cursor="SizeNS"
                      ToolTip="上下拖动：调整日志区与上方区域的高度"/>

        <!-- ④ 日志区 -->
        <Border Grid.Row="3" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="运行日志" Style="{StaticResource SectionTitle}"
                           Margin="0,0,0,8"/>
                <controls:LogPanel x:Name="LogPanel"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
