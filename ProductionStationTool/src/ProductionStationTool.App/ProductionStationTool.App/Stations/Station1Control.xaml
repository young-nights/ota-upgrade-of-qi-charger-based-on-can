<UserControl x:Class="ProductionStationTool.App.Stations.Station1Control"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ProductionStationTool.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*" MinHeight="220"/>
        </Grid.RowDefinitions>

        <!-- ① 串口接入区 -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <controls:ConnectionPanel x:Name="ConnPanel"/>
        </Border>

        <!-- ② 流程区 + ③ 数据展示区 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="5*"/>
            </Grid.ColumnDefinitions>

            <!-- 流程区 -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="测试流程" Style="{StaticResource SectionTitle}"/>
                        <Button Content="日志" Style="{StaticResource GhostButton}"
                                Height="26" Padding="12,0" HorizontalAlignment="Right"
                                Click="BtnLog_Click"
                                ToolTip="弹出运行日志窗口（不占主页面）"/>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <controls:FlowStepsPanel x:Name="FlowPanel"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 数据展示区：结果/SN/A线圈/B线圈 四组件等比放大（电压电流组件已移除），
                 异常项列表占满剩余行，整页免滚动 -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- 结果/SN 与 A/B 线圈吃掉剩余空间（等比放大）；
                             异常项列表固定高，不随窗口变大 -->
                        <RowDefinition Height="*" MinHeight="95"/>
                        <RowDefinition Height="*" MinHeight="115"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="100"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="数据展示" Style="{StaticResource SectionTitle}"
                               Margin="0,0,0,8"/>

                    <!-- 结果大字 + SN 码 并排 -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="BadgeResult" Grid.Column="0" Background="#F1F5F9" CornerRadius="8"
                                Padding="24,14" VerticalAlignment="Stretch">
                            <TextBlock x:Name="TxtResult" Text="待测试" FontSize="40"
                                       FontWeight="Bold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>
                        <Border Grid.Column="2" Background="{StaticResource FieldBgBrush}"
                                CornerRadius="8" Padding="16">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="SN 码" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="TxtSn" Text="—"
                                           FontSize="22" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 线圈 A/B 判定：两个组件并排，绿=通过 / 红=未通过 / 灰=未测 -->
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <controls:CoilJudgeCard x:Name="CardCoilA" Grid.Column="0" Title="线圈 A"/>
                        <controls:CoilJudgeCard x:Name="CardCoilB" Grid.Column="2" Title="线圈 B"/>
                    </Grid>

                    <!-- 检测参数只读提示（修改入口在「设置」页） -->
                    <TextBlock Grid.Row="3"
                               Text="检测参数（A/B 阈值、窗口、超时）在顶部菜单「设置 → 检测参数」中修改"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,8"/>

                    <!-- 异常项 -->
                    <TextBlock Grid.Row="4" Text="异常项" Style="{StaticResource SectionTitle}"
                               Margin="0,0,0,8"/>
                    <ListBox x:Name="ListAbnormal" Grid.Row="5" FontSize="14"
                             Background="{StaticResource FieldBgBrush}"
                             BorderBrush="{StaticResource CardBorderBrush}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
