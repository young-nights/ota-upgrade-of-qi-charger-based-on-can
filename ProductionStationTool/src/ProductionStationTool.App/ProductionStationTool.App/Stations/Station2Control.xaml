<UserControl x:Class="ProductionStationTool.App.Stations.Station2Control"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ProductionStationTool.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ① 串口接入区 -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <controls:ConnectionPanel x:Name="ConnPanel"/>
        </Border>

        <!-- ② 流程区 + ③ 数据展示区 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 流程区 -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="老化流程" Style="{StaticResource SectionTitle}"/>
                        <Button Content="日志" Style="{StaticResource GhostButton}"
                                Height="26" Padding="12,0" HorizontalAlignment="Right"
                                Click="BtnLog_Click"
                                ToolTip="弹出运行日志窗口（不占主页面）"/>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <controls:FlowStepsPanel x:Name="FlowPanel"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 数据展示区：结果/剩余时间/进度三列一行，老化项目列表占满剩余行 -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="数据展示" Style="{StaticResource SectionTitle}"
                               Margin="0,0,0,8"/>

                    <!-- 结果大字 + 老化进度 并排 -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="BadgeResult" Grid.Column="0" Background="#F1F5F9" CornerRadius="8"
                                Padding="20,10" VerticalAlignment="Stretch">
                            <TextBlock x:Name="TxtResult" Text="待老化" FontSize="32"
                                       FontWeight="Bold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource FieldBgBrush}"
                                CornerRadius="8" Padding="14">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="剩余时间" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="TxtRemaining" Text="30:00"
                                           FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="老化时长 30 分钟" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="{StaticResource FieldBgBrush}"
                                CornerRadius="8" Padding="14">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="老化进度" Style="{StaticResource FieldLabel}"/>
                                <ProgressBar x:Name="ProgressAging" Height="22"
                                             Minimum="0" Maximum="100"/>
                                <TextBlock x:Name="TxtProgressPct" Text="0%"
                                           FontSize="12" HorizontalAlignment="Right"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 老化说明 -->
                    <TextBlock Grid.Row="2" Text="老化项目" Style="{StaticResource SectionTitle}"
                               Margin="0,0,0,8"/>
                    <ListBox x:Name="ListDetails" Grid.Row="3" FontSize="14"
                             Background="{StaticResource FieldBgBrush}"
                             BorderBrush="{StaticResource CardBorderBrush}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
