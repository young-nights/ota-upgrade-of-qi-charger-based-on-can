<UserControl x:Class="ProductionStationTool.App.Controls.LogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TextBox x:Name="TxtLog"
             IsReadOnly="True"
             TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto"
             FontFamily="Consolas"
             FontSize="12"
             Background="#F8FAFC"
             BorderThickness="0"
             Padding="8"/>
</UserControl>
