<UserControl x:Class="ProductionStationTool.App.Controls.CoilJudgeCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="Card" Background="{StaticResource FieldBgBrush}" CornerRadius="8" Padding="14">
        <StackPanel>
            <TextBlock x:Name="TxtTitle" Text="线圈" Style="{StaticResource FieldLabel}"/>
            <TextBlock x:Name="TxtState" Text="未测" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
            <TextBlock x:Name="TxtCurrent" Text="—" FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
