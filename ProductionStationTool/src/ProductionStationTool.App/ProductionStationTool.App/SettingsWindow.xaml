<Window x:Class="ProductionStationTool.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="本机设置" Height="720" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">
    <TabControl x:Name="Tabs" Margin="16" Background="Transparent" BorderThickness="0">

        <!-- ===== 页 1：机位与网络 ===== -->
        <TabItem Header="机位与网络">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
                <StackPanel>

                    <!-- 本机身份 -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="本机身份（机位命名）" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="TxtCurrentCode" Text="当前编码：ST-01-1"
                                       FontSize="22" FontWeight="Bold" Margin="0,10,0,2"
                                       Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="机位数随产量动态增减：改名只写 machine.json，代码/服务器零改动；保存后重启软件生效。"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="工位号" Style="{StaticResource FieldLabel}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="CmbStationNo" Grid.Column="1" Style="{StaticResource FieldComboEditable}"
                                          IsEditable="True" SelectionChanged="Identity_Changed">
                                    <ComboBoxItem Content="1"/>
                                    <ComboBoxItem Content="2"/>
                                    <ComboBoxItem Content="3"/>
                                    <ComboBoxItem Content="4"/>
                                </ComboBox>
                                <TextBlock Grid.Column="3" Text="机位号" Style="{StaticResource FieldLabel}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtMachineId" Grid.Column="4" Style="{StaticResource FieldBox}"
                                         TextChanged="Identity_Changed"/>
                            </Grid>
                            <TextBlock Text="机位号 1~8 位字母/数字，同工位内不重复（如 1、2、3…）"
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="保存机位设置" Width="150" Height="40"
                                        Style="{StaticResource PrimaryButton}" Click="BtnSave_Click"/>
                                <TextBlock x:Name="TxtSaveResult" VerticalAlignment="Center"
                                           Margin="12,0,0,0" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 网络 -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="网络" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="本机 IP（只读；修改 IP 请用「打开网络设置」）"
                                       Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                            <TextBlock x:Name="TxtIps" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="服务器" Style="{StaticResource FieldLabel}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtServerHost" Grid.Column="1" Style="{StaticResource FieldBox}"
                                         VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Content="检测连通" Width="110" Height="36"
                                        Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                        Click="BtnPing_Click"/>
                            </Grid>
                            <TextBlock x:Name="TxtPingResult" FontSize="12" Margin="0,0,0,12"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                            <Button Content="打开网络设置（网卡/IPv4）" Width="230" Height="40"
                                    Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                    Click="BtnOpenNetwork_Click"
                                    ToolTip="打开 Windows 网络连接面板，改 IP/掩码/网关需管理员权限"/>
                        </StackPanel>
                    </Border>

                    <!-- 变更记录 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="变更记录（machine_change.log）" Style="{StaticResource SectionTitle}"/>
                            <TextBox x:Name="TxtLog" IsReadOnly="True" AcceptsReturn="True"
                                     TextWrapping="Wrap" Height="110" Margin="0,10,0,0"
                                     FontSize="11" FontFamily="Consolas"
                                     Background="{StaticResource FieldBgBrush}"
                                     BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ===== 页 2：检测参数 ===== -->
        <TabItem Header="检测参数">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="步骤 5 双线圈检测参数" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="A 线圈：采集窗口内均值电流落在 [A 下限, A 上限] 区间内即正常（低于下限=低流、高于上限=过流，均异常）；A 通过后实时监测跌落（低于 B 下限或 A 均值一半），跌落状态持续「跌落确认」时长才算有效换线圈（不判失败）；B 线圈：电流恢复进入 [B 下限, B 上限] 区间并持续规定时长即正常；整体超时（A 采集 + 换线圈 + B 判定）判 FAIL。保存后下次测试生效（存 machine.json，重启自动沿用）。"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,10,0,12"/>

                            <UniformGrid Columns="3">
                                <StackPanel Margin="0,0,8,0"
                                            ToolTip="A 下限：A 线圈均值电流低于此值判低流异常（默认 1.0A）">
                                    <TextBlock Text="A 下限 (A)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="BoxALower" Style="{StaticResource FieldBox}" Text="1.0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0"
                                            ToolTip="A 上限：A 线圈均值电流高于此值判过流异常（默认 2.0A）">
                                    <TextBlock Text="A 上限 (A)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="BoxAUpper" Style="{StaticResource FieldBox}" Text="2.0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0"
                                            ToolTip="B 下限：B 线圈恢复判定区间下沿（默认 1.0A）">
                                    <TextBlock Text="B 下限 (A)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="BoxBLower" Style="{StaticResource FieldBox}" Text="1.0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0"
                                            ToolTip="B 上限：B 线圈恢复判定区间上沿（默认 2.0A）">
                                    <TextBlock Text="B 上限 (A)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="BoxBUpper" Style="{StaticResource FieldBox}" Text="2.0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0"
                                            ToolTip="A 窗口：A 线圈固定采集时长（秒）。窗口内电流均值落在 A 上下限区间内即判 A 通过（默认 10s）">
                                    <TextBlock Text="A 窗口 (s)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="BoxAWindowSec" Style="{StaticResource FieldBox}" Text="10"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0"
                                            ToolTip="B 持续：B 线圈电流恢复进 B 上下限区间后，须连续保持在区间内该时长（秒）才判 B 通过（默认 3s）">
                                    <TextBlock Text="B 持续 (s)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="BoxBSustainSec" Style="{StaticResource FieldBox}" Text="3"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0"
                                            ToolTip="跌落确认：A 通过后电流处于跌落状态（低于 B 下限或 A 均值一半）须持续该时长（秒）才算有效换线圈，抗毛刺干扰（默认 2s）">
                                    <TextBlock Text="跌落确认 (s)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="BoxTransitionSec" Style="{StaticResource FieldBox}" Text="2"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0"
                                            ToolTip="采样间隔：PowerZ 启动帧重发节奏（毫秒），决定采样频率 ≈ 1000/间隔 Hz。默认 200ms ≈ 5Hz；范围 50~5000">
                                    <TextBlock Text="采样间隔 (ms)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="BoxSampleIntervalMs" Style="{StaticResource FieldBox}" Text="200"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="整体超时 (s)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="BoxTimeoutSec" Style="{StaticResource FieldBox}" Text="60"/>
                                </StackPanel>
                            </UniformGrid>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="保存检测参数" Width="150" Height="40"
                                        Style="{StaticResource PrimaryButton}" Click="BtnSaveCoil_Click"/>
                                <Button Content="恢复默认" Width="110" Height="40" Margin="12,0,0,0"
                                        Style="{StaticResource GhostButton}" Click="BtnCoilDefaults_Click"/>
                                <TextBlock x:Name="TxtCoilSaveResult" VerticalAlignment="Center"
                                           Margin="12,0,0,0" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ===== 页 3：版本预设（工位 4 比对） ===== -->
        <TabItem Header="版本预设">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="工位 4 软硬件版本预设" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="工位 4 读取设备软硬件版本后与此处预设比对，两项都匹配才 PASS。软件版本 = APP 固件版本串（UDS 0xF195），硬件版本（UDS 0xF193）。留空视为未预设，工位 4 版本比对不通过。"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,10,0,12"/>

                            <TextBlock Text="软件版本预设（如 QC_JYF_MCU1_FW_1.1.64）" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="BoxPresetSw" Style="{StaticResource FieldBox}" Margin="0,0,0,12"/>

                            <TextBlock Text="硬件版本预设（如 QC_JYF_HW_1.1.5）" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="BoxPresetHw" Style="{StaticResource FieldBox}" Margin="0,0,0,12"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="保存版本预设" Width="150" Height="40"
                                        Style="{StaticResource PrimaryButton}" Click="BtnSavePresets_Click"/>
                                <TextBlock x:Name="TxtPresetResult" VerticalAlignment="Center"
                                           Margin="12,0,0,0" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ===== 页 4：数据管理（良率口径 + 手动修正） ===== -->
        <TabItem Header="数据管理">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
                <StackPanel>

                    <!-- 良率统计口径 -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="良率统计口径" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="良率 = PASS 数 ÷ 参与统计的记录数 × 100%（按机位聚合显示在汇总机卡片上）。弃用记录指工位1 失败弃用/被新 SN 取代的记录——默认不计入良率，避免失败重拉污染口径。"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,10,0,12"/>
                            <CheckBox x:Name="ChkYieldExclude" Content="弃用记录不计入良率（推荐）"
                                      FontSize="13" Margin="0,0,0,12"/>
                            <TextBlock x:Name="TxtYieldSummary" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="保存口径" Width="150" Height="40"
                                        Style="{StaticResource PrimaryButton}" Click="BtnSaveYield_Click"/>
                                <Button Content="刷新统计" Width="110" Height="40" Margin="12,0,0,0"
                                        Style="{StaticResource GhostButton}" Click="BtnRefreshYield_Click"/>
                                <TextBlock x:Name="TxtYieldResult" VerticalAlignment="Center"
                                           Margin="12,0,0,0" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 手动修正良率（记录级标记） -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="手动修正（记录级标记）" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="误判记录在此标记弃用/恢复、或修正「打印出库」标记，良率按上方口径自动重算。标记按 SN 生效（同 SN 各工位记录一起改）。按 SN 查询，留空查最近 200 条。"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,10,0,12"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBox x:Name="BoxSnQuery" Width="260" Height="36"
                                         Style="{StaticResource FieldBox}" Margin="0,0,8,0"
                                         ToolTip="输入完整 SN 精确查询；留空查最近 200 条"/>
                                <Button Content="查询" Width="90" Height="36"
                                        Style="{StaticResource GhostButton}" Click="BtnQueryRecords_Click"/>
                                <Button Content="应用修改" Width="110" Height="36" Margin="8,0,0,0"
                                        Style="{StaticResource PrimaryButton}" Click="BtnApplyFix_Click"
                                        ToolTip="把下方表格中的弃用/打印标记写回数据库"/>
                            </StackPanel>

                            <DataGrid x:Name="GridFix" AutoGenerateColumns="False" IsReadOnly="False"
                                      SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      MaxHeight="260" FontSize="12">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="SN" Binding="{Binding Sn}" Width="*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="工位" Binding="{Binding StationNo}" Width="50" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="56" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="测试时间" Binding="{Binding TestTime, StringFormat=yyyy-MM-dd HH:mm}" Width="120" IsReadOnly="True"/>
                                    <DataGridCheckBoxColumn Header="弃用" Binding="{Binding Abandoned, UpdateSourceTrigger=PropertyChanged}" Width="56"/>
                                    <DataGridCheckBoxColumn Header="打印出库" Binding="{Binding Printed, UpdateSourceTrigger=PropertyChanged}" Width="76"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
