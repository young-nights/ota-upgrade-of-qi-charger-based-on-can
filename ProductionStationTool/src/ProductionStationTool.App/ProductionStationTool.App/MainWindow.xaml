<Window x:Class="ProductionStationTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ProductionStationTool.App"
        Title="产线测试上位机" Height="780" Width="1280"
        MinWidth="1100" MinHeight="680"
        Background="{StaticResource BgBrush}">
    <Grid>
    <DockPanel x:Name="WorkstationView">
        <!-- 顶部横幅：下拉菜单（设置 / 工位选择 / 关于）+ 汇总机入口 -->
        <Border DockPanel.Dock="Top" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1"
                Padding="12,2">
            <Grid>
                <Menu Background="Transparent" FontSize="14">
                    <MenuItem Header="设置">
                        <MenuItem Header="机位与网络…" Click="MenuSettingsNetwork_Click"/>
                        <MenuItem Header="检测参数…" Click="MenuSettingsCoil_Click"/>
                        <MenuItem Header="版本预设…" Click="MenuSettingsPresets_Click"/>
                    </MenuItem>
                    <!-- 工位切换：菜单栏下拉，勾选当前工位；默认工位1 -->
                    <MenuItem x:Name="MenuStations" Header="工位选择">
                        <MenuItem Header="工位1 — SN + 电流电压" Tag="0"
                                  IsCheckable="True" IsChecked="True" Click="MenuStation_Click"/>
                        <MenuItem Header="工位2 — 老化测试" Tag="1"
                                  IsCheckable="True" Click="MenuStation_Click"/>
                        <MenuItem Header="工位3 — SN复测 + 线圈A/B" Tag="2"
                                  IsCheckable="True" Click="MenuStation_Click"/>
                        <MenuItem Header="工位4 — 出货门禁 + 版本比对" Tag="3"
                                  IsCheckable="True" Click="MenuStation_Click"/>
                    </MenuItem>
                    <MenuItem Header="关于">
                        <MenuItem Header="关于 ProductionStationTool…" Click="MenuAbout_Click"/>
                    </MenuItem>
                </Menu>
                <Button x:Name="BtnSummary" Content="汇总机" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Height="32" Padding="18,0"
                        Style="{StaticResource PrimaryButton}" Click="BtnSummary_Click"
                        ToolTip="进入汇总机管理页（服务器电脑：工位机接入与数据库管理，需密码）"/>
            </Grid>
        </Border>
        <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 操作栏 + 工位页面宿主 -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶部操作栏 -->
            <Border Grid.Row="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtCurrent" Text="工位1 — SN + 电流电压"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="自动检测串口/CAN → 点击「开始测试」自动跑完流程"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnStart" Content="开始测试" Width="150" Height="52"
                                FontSize="20" FontWeight="SemiBold"
                                Style="{StaticResource PrimaryButton}"
                                IsEnabled="False"
                                ToolTip="CAN 与 PowerZ 串口接入后可点"
                                Click="BtnStart_Click"/>
                        <Button x:Name="BtnNext" Content="下一个" Width="140" Height="52"
                                FontSize="18" Margin="12,0,0,0"
                                Style="{StaticResource GhostButton}"
                                IsEnabled="False"
                                Click="BtnNext_Click"
                                ToolTip="完整跑通一次流程后可点：切换下一台，刷新状态，串口保持连接"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 工位页面宿主（Stretch 约束高度，分隔条才能让上下区同步缩放） -->
            <ContentControl x:Name="PageHost" Grid.Row="2"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0" Width="10" Height="10"
                         Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtStatus" Grid.Column="1" Margin="8,0,0,0"
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                           Text="就绪：自动检测串口/CAN 后点击「开始测试」"/>
                <TextBlock Grid.Column="2" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="ProductionStationTool"/>
            </Grid>
        </Border>
        </Grid>
    </DockPanel>

        <!-- 汇总机页面：整页接管工作区（非弹窗），密码解锁后管理工位机接入与数据库 -->
        <local:SummaryMachinePage x:Name="SummaryView" Visibility="Collapsed"/>
    </Grid>
</Window>
