<Window x:Class="ProductionStationTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="产线测试上位机" Height="640" Width="1000">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 左：工位选择 -->
        <GroupBox Grid.Row="0" Grid.Column="0" Header="工位选择">
            <ListBox x:Name="ListStations" FontSize="18"
                     SelectedIndex="0"
                     SelectionChanged="ListStations_SelectionChanged">
                <ListBoxItem Content="工位1 — SN + 电流电压"/>
                <ListBoxItem Content="工位2 — 老化测试"/>
                <ListBoxItem Content="工位3 — 预留"/>
                <ListBoxItem Content="工位4 — 预留"/>
            </ListBox>
        </GroupBox>

        <!-- 右：当前工位页面 + 操作按钮 -->
        <Grid Grid.Row="0" Grid.Column="1" Margin="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <Button x:Name="BtnStart" Content="开始测试" Width="160" Height="56"
                        FontSize="24" Click="BtnStart_Click"/>
                <Button x:Name="BtnFactoryReset" Content="恢复出厂设置" Width="160" Height="56"
                        FontSize="18" Margin="16,0,0,0" Click="BtnFactoryReset_Click"/>
                <TextBlock x:Name="TxtCurrent" VerticalAlignment="Center"
                           FontSize="16" Margin="24,0,0,0" Text="当前：工位1"/>
            </StackPanel>

            <!-- 工位页面宿主 -->
            <ContentControl x:Name="PageHost" Grid.Row="1"/>
        </Grid>

        <!-- 状态栏 -->
        <TextBlock x:Name="TxtStatus" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0"
                   Text="就绪：自动检测串口/CAN 后点击「开始测试」"/>
    </Grid>
</Window>
