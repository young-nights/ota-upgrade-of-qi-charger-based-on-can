<Window x:Class="ProductionStationTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="产线测试工位" Height="600" Width="900">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 一键执行 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="BtnStart" Content="开始测试" Width="160" Height="56"
                    FontSize="24" Click="BtnStart_Click"/>
            <Button x:Name="BtnFactoryReset" Content="恢复出厂设置" Width="160" Height="56"
                    FontSize="18" Margin="16,0,0,0" Click="BtnFactoryReset_Click"/>
        </StackPanel>

        <!-- 结果大字 -->
        <TextBlock x:Name="TxtResult" Grid.Row="1" Text="待测试"
                   FontSize="64" FontWeight="Bold" HorizontalAlignment="Center"
                   Margin="0,8,0,16"/>

        <!-- 异常项 / 详情 -->
        <GroupBox Grid.Row="2" Header="测试详情（异常项红字）">
            <ListBox x:Name="ListDetails" FontSize="16"/>
        </GroupBox>

        <!-- 状态栏 -->
        <TextBlock x:Name="TxtStatus" Grid.Row="3" Margin="0,12,0,0"
                   Text="就绪：自动检测串口/CAN 后点击「开始测试」"/>
    </Grid>
</Window>
