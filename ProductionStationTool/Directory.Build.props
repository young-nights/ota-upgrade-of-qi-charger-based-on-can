<Project>
  <!--
    构建产物必须跟随各自的项目目录，不能汇总到仓库根目录。
    每个 .csproj 使用自身的 bin/obj：
      <project-dir>/bin/<Configuration>/<TargetFramework>/
      <project-dir>/obj/<Configuration>/<TargetFramework>/
  -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', 'obj'))</BaseIntermediateOutputPath>
    <BaseOutputPath>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', 'bin'))</BaseOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/obj/**;**/bin/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
