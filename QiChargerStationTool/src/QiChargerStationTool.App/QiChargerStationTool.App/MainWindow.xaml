<Window x:Class="QiChargerStationTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Qi 充电模块 · 产线测试上位机" Height="720" Width="1120"
        MinHeight="600" MinWidth="1080"
        WindowState="Maximized" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        Background="#F7F7F7" Foreground="#222"
        FontFamily="Microsoft YaHei UI" FontSize="13">
  <Window.Resources>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="4,3"/>
      <Setter Property="Margin" Value="2"/>
      <Setter Property="BorderBrush" Value="#C5C5C5"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#222"/>
    </Style>
    <!-- 统一浅灰按钮 -->
    <Style x:Key="GrayBtn" TargetType="Button">
      <Setter Property="Background" Value="#E8E8E8"/>
      <Setter Property="Foreground" Value="#222"/>
      <Setter Property="BorderBrush" Value="#CCC"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="Margin" Value="3"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#DADADA"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#F0F0F0"/>
                <Setter Property="Foreground" Value="#AAA"/>
                <Setter Property="BorderBrush" Value="#E0E0E0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#222"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#222"/>
      <Setter Property="BorderBrush" Value="#D5D5D5"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#DDD"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
  </Window.Resources>

  <!-- 响应式布局：画布随窗口铺满（2026-11-12 去掉 Viewbox+固定画布——
       Uniform 缩放在最大化窗口上留边占不满，改 Grid 自适应填充） -->
    <Grid Margin="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="440"/>
      <ColumnDefinition Width="200"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 顶部连接 + 固件 -->
    <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" CornerRadius="4" Padding="8" Margin="0,0,0,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="170"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="COM 口" FontWeight="Bold" VerticalAlignment="Center" Margin="0,2"/>
        <ComboBox x:Name="CmbPort" Grid.Column="1" Height="30" Margin="2"
                  VerticalContentAlignment="Center"
                  DisplayMemberPath="DisplayName"
                  ToolTip="自动扫描串口，★ 为 ZQWL CAN 盒子（默认认 VID_3562，可配置 ExtraComMatch）"/>
        <Button Grid.Column="2" Content="扫描" Style="{StaticResource GrayBtn}"
                Width="56" Height="30" MinHeight="30" Margin="2,2,4,2"
                Click="OnScanPorts"
                ToolTip="重新扫描系统串口并自动选中 ZQWL CAN 盒子"/>
        <Button x:Name="BtnConnect" Grid.Column="3" Content="连接" Style="{StaticResource GrayBtn}"
                Width="56" Height="30" MinHeight="30" Margin="2,2,4,2"
                Click="OnConnect"
                ToolTip="打开所选 COM 口并初始化 CAN（250k 扩展帧）"/>
        <Button x:Name="BtnDisconnect" Grid.Column="4" Content="断开" Style="{StaticResource GrayBtn}"
                Width="56" Height="30" MinHeight="30" Margin="2,2,8,2"
                Click="OnDisconnect" IsEnabled="False"
                ToolTip="关闭 COM 口连接"/>
        <TextBlock Grid.Column="5" Text="波特率" FontWeight="Bold" VerticalAlignment="Center" Margin="0,2"/>
        <!-- ZQWL 私有协议固定 2M，只读展示不可改 -->
        <Border Grid.Column="6" Width="110" VerticalAlignment="Center" Margin="6,2,0,2"
                Background="#F0F0F0" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3"
                ToolTip="ZQWL-CANFD USB 私有协议固定 2000000，不可修改">
          <TextBlock Text="2000000 (固定)" Foreground="#666" Padding="6,4"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- AT32 OTA 固件 -->
        <TextBlock Grid.Row="1" Text="AT32 OTA 固件" FontWeight="Bold"
                   VerticalAlignment="Center" Margin="0,8,0,2" Grid.ColumnSpan="1"/>
        <TextBox x:Name="TxtOtaFirmware" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="6"
                 Text="" Margin="2,8,2,2" VerticalContentAlignment="Center"
                 ToolTip="AT32 APP 升级镜像（.bin，XATO 签名包）"/>
        <Button Grid.Row="1" Grid.Column="7" Content="浏览…" Style="{StaticResource GrayBtn}"
                Width="72" HorizontalAlignment="Left" Margin="2,8,0,2"
                Click="OnBrowseOtaFirmware"/>

        <!-- QI IAP 固件 -->
        <TextBlock Grid.Row="2" Text="QI IAP 固件" FontWeight="Bold"
                   VerticalAlignment="Center" Margin="0,8,0,2"/>
        <TextBox x:Name="TxtIapFirmware" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="6"
                 Text="" Margin="2,8,2,2" VerticalContentAlignment="Center"
                 ToolTip="Qi 芯片 IAP 固件（.bin）"/>
        <Button Grid.Row="2" Grid.Column="7" Content="浏览…" Style="{StaticResource GrayBtn}"
                Width="72" HorizontalAlignment="Left" Margin="2,8,0,2"
                Click="OnBrowseIapFirmware"/>
      </Grid>
    </Border>

    <!-- 左：Qi 状态仪表盘 + SN + 状态 -->
    <Border Grid.Row="1" Grid.Column="0" CornerRadius="4" Padding="12" Margin="0,0,6,6">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <!-- Qi 状态仪表盘 -->
        <TextBlock Text="Qi 状态" FontWeight="Bold" Foreground="#333"/>
        <Border Background="#E3F2FD" CornerRadius="6" Padding="12,10" Margin="0,6,0,8">
          <StackPanel>
            <TextBlock Text="充电功率" FontSize="11" Foreground="#5B7FA6"/>
            <TextBlock x:Name="TxtQiPower" Text="— mW" FontSize="30" FontWeight="Bold"
                       Foreground="#0D47A1" Margin="0,2,0,0"/>
            <TextBlock x:Name="TxtQiPowerW" Text="（— W）" FontSize="12" Foreground="#5B7FA6"
                       Margin="0,2,0,0"/>
            <!-- 次数 / 磁铁并排（2026-11-12 横向压缩高度，免滚动） -->
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="充电次数" FontSize="11" Foreground="#5B7FA6"/>
                <TextBlock x:Name="TxtChargeCount" Text="— 次" FontSize="18" FontWeight="Bold"
                           Foreground="#0D47A1" Margin="0,2,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="磁铁 / 实际充电" FontSize="11" Foreground="#5B7FA6"/>
                <TextBlock x:Name="TxtMagnetState" Text="—" FontSize="18" FontWeight="Bold"
                           Foreground="#0D47A1" Margin="0,2,0,0"
                           ToolTip="充电显示态（DID 0x2117；状态字节 b1=充电中/b2=充满；PA0 霍尔 0x00=磁铁存在）&#x0a;绿=磁铁不存在·充电中　橙=磁铁不存在·未充电&#x0a;红=磁铁存在·未充电　蓝=充电失能　青=电已充满&#x0a;（ping=状态字节 b0=设备放置，独立指示不在此轮转）"/>
              </StackPanel>
            </Grid>
            <!-- 设备放置指示（状态字节 b0，独立显示，不抢占磁铁/充电状态） -->
            <Border x:Name="BdPlacement" CornerRadius="10" Padding="10,3" Margin="0,10,0,0"
                    HorizontalAlignment="Left" Background="#ECEFF1">
                <TextBlock x:Name="TxtPlacement" Text="设备放置: —" FontSize="11" Foreground="#78909C"/>
            </Border>
            <TextBlock FontSize="10" Foreground="#78909C" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="绿=磁铁不存在·充电中；橙=磁铁不存在·未充电；红=磁铁存在·未充电；蓝=充电失能；青=电已充满"/>
          </StackPanel>
        </Border>
        <TextBlock Text="保护位" FontWeight="Bold" Foreground="#333" Margin="0,0,0,4"/>
        <WrapPanel x:Name="PanelProtections">
          <Border x:Name="BdOvp" CornerRadius="3" Padding="6,3" Margin="0,2,4,2"
                  Background="#E8F5E9"><TextBlock Text="OVP 过压" FontSize="11" Foreground="#2E7D32"/></Border>
          <Border x:Name="BdUvp" CornerRadius="3" Padding="6,3" Margin="0,2,4,2"
                  Background="#E8F5E9"><TextBlock Text="UVP 欠压" FontSize="11" Foreground="#2E7D32"/></Border>
          <Border x:Name="BdOcp" CornerRadius="3" Padding="6,3" Margin="0,2,4,2"
                  Background="#E8F5E9"><TextBlock Text="OCP 过流" FontSize="11" Foreground="#2E7D32"/></Border>
          <Border x:Name="BdOtp" CornerRadius="3" Padding="6,3" Margin="0,2,4,2"
                  Background="#E8F5E9"><TextBlock Text="OTP 过温" FontSize="11" Foreground="#2E7D32"/></Border>
          <Border x:Name="BdFod" CornerRadius="3" Padding="6,3" Margin="0,2,4,2"
                  Background="#E8F5E9"><TextBlock Text="FOD 异物" FontSize="11" Foreground="#2E7D32"/></Border>
        </WrapPanel>
        <TextBlock x:Name="TxtQiSummary" Margin="0,6,0,0" Foreground="#555" FontSize="11"
                   TextWrapping="Wrap" Text="充电状态: —   PCB: —℃   档位: —"/>

        <Separator Margin="0,12,0,8"/>

        <TextBlock Text="SN 读写 / 扫码" FontWeight="Bold" Foreground="#333"/>
        <TextBlock Text="光标在输入框时，扫码枪扫码即自动填入"
                   Foreground="#888" FontSize="11" Margin="0,2,0,8" TextWrapping="Wrap"/>
        <TextBox x:Name="TxtSn" FontSize="20" FontWeight="Bold" Height="42"
                 VerticalContentAlignment="Center" Padding="6,2" Margin="0"
                 BorderBrush="#90CAF9" BorderThickness="2"
                 Background="#F0F7FF" Foreground="#0D47A1"
                 AcceptsReturn="False" KeyDown="OnSnKeyDown" GotFocus="OnSnGotFocus"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Button x:Name="BtnSnRead" Content="读取" Style="{StaticResource GrayBtn}" Width="72"
                  Click="OnSnRead" Margin="0,0,4,0"/>
          <Button x:Name="BtnSnWrite" Content="写入" Style="{StaticResource GrayBtn}" Width="72"
                  Click="OnSnWrite" Margin="0,0,4,0"/>
          <Button Content="清空" Style="{StaticResource GrayBtn}" Width="72"
                  Click="OnSnClear"/>
        </StackPanel>
        <TextBlock x:Name="TxtSnHint" Margin="0,8,0,0" Foreground="#888"
                   FontSize="11" TextWrapping="Wrap" MinHeight="16"/>

        <Separator Margin="0,12,0,8"/>
        <TextBlock Text="状态" FontWeight="Bold"/>
        <TextBlock x:Name="TxtState" Text="就绪" Foreground="#1565C0"
                   FontSize="26" FontWeight="Bold" Margin="0,2,0,0"/>
        <TextBlock x:Name="TxtStateDetail" Foreground="#888" FontSize="11"
                   TextWrapping="Wrap" Margin="0,4,0,0"/>
      </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- 中：操作按钮列 -->
    <Border Grid.Row="1" Grid.Column="1" CornerRadius="4" Padding="10" Margin="0,0,6,6">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock Text="测试操作" FontWeight="Bold" Foreground="#333" Margin="0,0,0,8"/>
        <Button x:Name="BtnReadVersion" Content="读版本" Style="{StaticResource GrayBtn}"
                Click="OnReadVersion"
                ToolTip="一次读取 MCU1 APP / MCU2 Qi / Boot / HW 四路版本"/>
        <Button x:Name="BtnOta" Content="OTA 升级" Style="{StaticResource GrayBtn}"
                Click="OnOtaUpgrade"/>
        <Button x:Name="BtnIap" Content="IAP 升级" Style="{StaticResource GrayBtn}"
                Click="OnIapUpgrade"/>
        <Separator Margin="6,10"/>
        <Button x:Name="BtnQiStatus" Content="Qi 状态检测" Style="{StaticResource GrayBtn}"
                Click="OnQiStatusQuery" IsEnabled="False"
                ToolTipService.ShowOnDisabled="True"
                ToolTip="充电未开启：Qi 芯片未供电（PB2 关闭），无法检测。&#10;请先点击「开启充电」。"/>
        <Button x:Name="BtnLinkProbe" Content="链路自检" Style="{StaticResource GrayBtn}"
                Click="OnLinkProbe"
                ToolTip="发 3E 00 + 22 F195，打印收发，判断是无回包还是协议不匹配"/>
        <TextBlock Text="Qi 功率档位" FontWeight="Bold" Margin="6,8,6,2"/>
        <ComboBox x:Name="CmbQiPower" Margin="6,0,6,4" Height="30"
                  VerticalContentAlignment="Center" SelectedIndex="2">
          <ComboBoxItem Content="5W" Tag="1"/>
          <ComboBoxItem Content="10W" Tag="2"/>
          <ComboBoxItem Content="15W" Tag="3"/>
        </ComboBox>
        <Button x:Name="BtnQiSetPower" Content="设置 Qi 功率" Style="{StaticResource GrayBtn}"
                Click="OnQiSetPower"
                ToolTip="写 DID 0x210D（扩展会话+SA）。档位码 0x01=5W / 0x02=10W / 0x03=15W，映射 Qi 芯片 QI_POWER_*"/>
        <Separator Margin="6,10"/>
        <Button x:Name="BtnChargeOn" Content="开启充电" Style="{StaticResource GrayBtn}"
                Click="OnChargeOn"/>
        <Button x:Name="BtnChargeOff" Content="关闭充电" Style="{StaticResource GrayBtn}"
                Click="OnChargeOff"/>
        <Separator Margin="6,10"/>
        <Button x:Name="BtnStop" Content="停 止" Style="{StaticResource GrayBtn}"
                Click="OnStop" IsEnabled="False"/>
        <Button x:Name="BtnClearResult" Content="清空记录" Style="{StaticResource GrayBtn}"
                Click="OnClearResult"/>
      </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- 右：运行日志 + 操作记录（上下两栏，边框分隔） -->
    <Grid Grid.Row="1" Grid.Column="2" Margin="6,0,0,6">
      <Grid.RowDefinitions>
        <RowDefinition Height="3*"/>
        <RowDefinition Height="12"/>
        <RowDefinition Height="2*"/>
      </Grid.RowDefinitions>

      <!-- 运行日志 -->
      <Border Grid.Row="0" CornerRadius="4" BorderBrush="#B0BEC5" BorderThickness="1">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="#ECEFF1" Padding="8,6">
            <DockPanel>
              <TextBlock Text="运行日志" FontWeight="Bold" Foreground="#37474F"
                         VerticalAlignment="Center"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="复制日志" Style="{StaticResource GrayBtn}" MinHeight="24" Padding="8,2"
                        Margin="2,0" Click="OnCopyLog"
                        ToolTip="复制全部运行日志到剪贴板（Ctrl+A 全选后 Ctrl+C 也可）"/>
                <Button Content="导出…" Style="{StaticResource GrayBtn}" MinHeight="24" Padding="8,2"
                        Margin="2,0" Click="OnExportLog"
                        ToolTip="把运行日志保存为 .txt 文件"/>
                <Button Content="清空" Style="{StaticResource GrayBtn}" MinHeight="24" Padding="8,2"
                        Margin="2,0" Click="OnClearLog"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <TextBox x:Name="TxtLog" FontFamily="Consolas" FontSize="11"
                   IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                   VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Auto"
                   BorderThickness="0" Padding="4" Margin="0"
                   Background="White" Foreground="#222"
                   VerticalContentAlignment="Top"/>
        </DockPanel>
      </Border>

      <!-- 操作记录（多行块，自动换行） -->
      <Border Grid.Row="2" CornerRadius="4" BorderBrush="#B0BEC5" BorderThickness="1">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="#E8EAF6" Padding="8,6">
            <TextBlock Text="操作记录" FontWeight="Bold" Foreground="#283593"/>
          </Border>
          <ListBox x:Name="LstResult" BorderThickness="0" Padding="4"
                   FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="6,5"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Background" Value="#FAFAFA"/>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}"
                           TextWrapping="Wrap"
                           FontFamily="Consolas"
                           Foreground="#222"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Grid>

    <TextBlock Grid.Row="2" Grid.ColumnSpan="3"
               Text="ZQWL-CANFD 250k ext · UDS 0x18DA0D03 / 0x18DA030D"
               Foreground="#999" FontSize="11" Margin="2,6,0,0"/>
    </Grid>
</Window>
