<Window x:Class="QiChargerStationTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Qi 充电模块 · 产线测试上位机" Height="720" Width="1120"
        Background="#F7F7F7" Foreground="#222"
        FontFamily="Microsoft YaHei UI" FontSize="13">
  <Window.Resources>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="4,3"/>
      <Setter Property="Margin" Value="2"/>
      <Setter Property="BorderBrush" Value="#C5C5C5"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#222"/>
    </Style>
    <!-- 统一浅灰按钮 -->
    <Style x:Key="GrayBtn" TargetType="Button">
      <Setter Property="Background" Value="#E8E8E8"/>
      <Setter Property="Foreground" Value="#222"/>
      <Setter Property="BorderBrush" Value="#CCC"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="Margin" Value="3"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#DADADA"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#F0F0F0"/>
                <Setter Property="Foreground" Value="#AAA"/>
                <Setter Property="BorderBrush" Value="#E0E0E0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#222"/>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#222"/>
      <Setter Property="BorderBrush" Value="#D5D5D5"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#DDD"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
  </Window.Resources>

  <Grid Margin="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="320"/>
      <ColumnDefinition Width="200"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 顶部连接 + 固件 -->
    <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" CornerRadius="4" Padding="8" Margin="0,0,0,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="COM 口" FontWeight="Bold" VerticalAlignment="Center" Margin="0,2"/>
        <TextBox x:Name="TxtPort" Grid.Column="1" Text="COM9" VerticalContentAlignment="Center"/>
        <TextBlock Grid.Column="2" Text="波特率" FontWeight="Bold" VerticalAlignment="Center" Margin="12,2,0,2"/>
        <TextBox x:Name="TxtBaud" Grid.Column="3" Text="2000000" VerticalContentAlignment="Center"/>

        <!-- AT32 OTA 固件 -->
        <TextBlock Grid.Row="1" Text="AT32 OTA 固件" FontWeight="Bold"
                   VerticalAlignment="Center" Margin="0,8,0,2"/>
        <TextBox x:Name="TxtOtaFirmware" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                 Text="" Margin="2,8,2,2" VerticalContentAlignment="Center"
                 ToolTip="AT32 APP 升级镜像（.bin，XATO 签名包）"/>
        <Button Grid.Row="1" Grid.Column="4" Content="浏览…" Style="{StaticResource GrayBtn}"
                Width="72" HorizontalAlignment="Left" Margin="2,8,0,2"
                Click="OnBrowseOtaFirmware"/>

        <!-- QI IAP 固件 -->
        <TextBlock Grid.Row="2" Text="QI IAP 固件" FontWeight="Bold"
                   VerticalAlignment="Center" Margin="0,8,0,2"/>
        <TextBox x:Name="TxtIapFirmware" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                 Text="" Margin="2,8,2,2" VerticalContentAlignment="Center"
                 ToolTip="Qi 芯片 IAP 固件（.bin）"/>
        <Button Grid.Row="2" Grid.Column="4" Content="浏览…" Style="{StaticResource GrayBtn}"
                Width="72" HorizontalAlignment="Left" Margin="2,8,0,2"
                Click="OnBrowseIapFirmware"/>
      </Grid>
    </Border>

    <!-- 左：SN + 状态 -->
    <Border Grid.Row="1" Grid.Column="0" CornerRadius="4" Padding="12" Margin="0,0,6,6">
      <StackPanel>
        <TextBlock Text="SN 读写 / 扫码" FontWeight="Bold" Foreground="#333"/>
        <TextBlock Text="光标在输入框时，扫码枪扫码即自动填入"
                   Foreground="#888" FontSize="11" Margin="0,2,0,8" TextWrapping="Wrap"/>
        <TextBox x:Name="TxtSn" FontSize="20" FontWeight="Bold" Height="42"
                 VerticalContentAlignment="Center" Padding="6,2" Margin="0"
                 BorderBrush="#90CAF9" BorderThickness="2"
                 Background="#F0F7FF" Foreground="#0D47A1"
                 AcceptsReturn="False" KeyDown="OnSnKeyDown" GotFocus="OnSnGotFocus"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Button x:Name="BtnSnRead" Content="读取" Style="{StaticResource GrayBtn}" Width="72"
                  Click="OnSnRead" Margin="0,0,4,0"/>
          <Button x:Name="BtnSnWrite" Content="写入" Style="{StaticResource GrayBtn}" Width="72"
                  Click="OnSnWrite" Margin="0,0,4,0"/>
          <Button Content="清空" Style="{StaticResource GrayBtn}" Width="72"
                  Click="OnSnClear"/>
        </StackPanel>
        <TextBlock x:Name="TxtSnHint" Margin="0,8,0,0" Foreground="#888"
                   FontSize="11" TextWrapping="Wrap" MinHeight="16"/>

        <Separator Margin="0,16,0,12"/>
        <TextBlock Text="状态" FontWeight="Bold"/>
        <TextBlock x:Name="TxtState" Text="就绪" Foreground="#1565C0"
                   FontSize="26" FontWeight="Bold" Margin="0,2,0,0"/>
        <TextBlock x:Name="TxtStateDetail" Foreground="#888" FontSize="11"
                   TextWrapping="Wrap" Margin="0,4,0,0"/>
      </StackPanel>
    </Border>

    <!-- 中：操作按钮列 -->
    <Border Grid.Row="1" Grid.Column="1" CornerRadius="4" Padding="10" Margin="0,0,6,6">
      <StackPanel>
        <TextBlock Text="测试操作" FontWeight="Bold" Foreground="#333" Margin="0,0,0,8"/>
        <Button x:Name="BtnReadVersion" Content="读软件版本" Style="{StaticResource GrayBtn}"
                Click="OnReadVersion"/>
        <Button x:Name="BtnOta" Content="OTA 升级" Style="{StaticResource GrayBtn}"
                Click="OnOtaUpgrade"/>
        <Button x:Name="BtnIap" Content="IAP 升级" Style="{StaticResource GrayBtn}"
                Click="OnIapUpgrade"/>
        <Separator Margin="6,10"/>
        <Button x:Name="BtnQiStatus" Content="Qi 状态查询" Style="{StaticResource GrayBtn}"
                Click="OnQiStatusQuery"
                ToolTip="全量读取 IAP 状态 / 充电状态 / 功率 / 温度 / FOD / 故障 / 热降额 / 功率档位"/>
        <TextBlock Text="Qi 功率档位" FontWeight="Bold" Margin="6,8,6,2"/>
        <ComboBox x:Name="CmbQiPower" Margin="6,0,6,4" Height="30"
                  VerticalContentAlignment="Center" SelectedIndex="2">
          <ComboBoxItem Content="5W" Tag="500"/>
          <ComboBoxItem Content="10W" Tag="1000"/>
          <ComboBoxItem Content="15W" Tag="1500"/>
        </ComboBox>
        <Button x:Name="BtnQiSetPower" Content="设置 Qi 功率" Style="{StaticResource GrayBtn}"
                Click="OnQiSetPower"
                ToolTip="写 DID 0x210D（扩展会话+SA）。固件仅接受 500/1000/1500，对应 5W/10W/15W"/>
        <Separator Margin="6,10"/>
        <Button x:Name="BtnChargeOn" Content="开启充电" Style="{StaticResource GrayBtn}"
                Click="OnChargeOn"/>
        <Button x:Name="BtnChargeOff" Content="关闭充电" Style="{StaticResource GrayBtn}"
                Click="OnChargeOff"/>
        <Separator Margin="6,10"/>
        <Button x:Name="BtnStop" Content="停 止" Style="{StaticResource GrayBtn}"
                Click="OnStop" IsEnabled="False"/>
        <Button x:Name="BtnClearResult" Content="清空记录" Style="{StaticResource GrayBtn}"
                Click="OnClearResult"/>
      </StackPanel>
    </Border>

    <!-- 右：运行日志 + 操作记录（上下两栏，边框分隔） -->
    <Grid Grid.Row="1" Grid.Column="2" Margin="6,0,0,6">
      <Grid.RowDefinitions>
        <RowDefinition Height="3*"/>
        <RowDefinition Height="12"/>
        <RowDefinition Height="2*"/>
      </Grid.RowDefinitions>

      <!-- 运行日志 -->
      <Border Grid.Row="0" CornerRadius="4" BorderBrush="#B0BEC5" BorderThickness="1">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="#ECEFF1" Padding="8,6">
            <TextBlock Text="运行日志" FontWeight="Bold" Foreground="#37474F"/>
          </Border>
          <ListBox x:Name="LstLog" FontFamily="Consolas" FontSize="11"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto"
                   BorderThickness="0" Padding="4"/>
        </DockPanel>
      </Border>

      <!-- 操作记录 -->
      <Border Grid.Row="2" CornerRadius="4" BorderBrush="#B0BEC5" BorderThickness="1">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="#E8EAF6" Padding="8,6">
            <TextBlock Text="操作记录" FontWeight="Bold" Foreground="#283593"/>
          </Border>
          <ListBox x:Name="LstResult" BorderThickness="0" Padding="4"
                   FontSize="12"/>
        </DockPanel>
      </Border>
    </Grid>

    <TextBlock Grid.Row="2" Grid.ColumnSpan="3"
               Text="ZQWL-CANFD 250k ext · UDS 0x18DA0D03 / 0x18DA030D"
               Foreground="#999" FontSize="11" Margin="2,6,0,0"/>
  </Grid>
</Window>
