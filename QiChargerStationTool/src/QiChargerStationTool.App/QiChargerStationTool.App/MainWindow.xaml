<Window x:Class="QiChargerStationTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Qi 充电模块 · 产线测试上位机" Height="720" Width="1100"
        Background="#1E1E1E" Foreground="#EEE">
  <Grid Margin="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="320"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="280"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 连接配置 -->
    <Border Grid.Row="0" Grid.Column="0" Background="#2A2A2A" CornerRadius="6" Padding="12" Margin="0,0,8,8">
      <StackPanel>
        <TextBlock Text="连接" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
          </Grid.RowDefinitions>
          <TextBlock Text="COM 口" VerticalAlignment="Center"/>
          <TextBox x:Name="TxtPort" Grid.Column="1" Text="COM9" Margin="4"/>
          <TextBlock Text="波特率" Grid.Row="1" VerticalAlignment="Center"/>
          <TextBox x:Name="TxtBaud" Grid.Row="1" Grid.Column="1" Text="2000000" Margin="4"/>
          <TextBlock Text="固件路径" Grid.Row="2" VerticalAlignment="Center"/>
          <TextBox x:Name="TxtFirmware" Grid.Row="2" Grid.Column="1" Text="firmware/app_image.bin" Margin="4"/>
          <TextBlock Text="SN" Grid.Row="3" VerticalAlignment="Center"/>
          <TextBox x:Name="TxtSn" Grid.Row="3" Grid.Column="1" Margin="4"/>
        </Grid>
      </StackPanel>
    </Border>

    <!-- 测试项 -->
    <Border Grid.Row="1" Grid.Column="0" Background="#2A2A2A" CornerRadius="6" Padding="12" Margin="0,0,8,8">
      <StackPanel>
        <TextBlock Text="测试项" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
        <CheckBox x:Name="ChkVersion" Content="读软件版本 (0xF195)" IsChecked="True" Margin="0,4"/>
        <CheckBox x:Name="ChkSn" Content="写 SN (0xF18C)" Margin="0,4"/>
        <CheckBox x:Name="ChkOta" Content="OTA 升级 (31/34/36/37)" IsChecked="True" Margin="0,4"/>
        <CheckBox x:Name="ChkCharge" Content="充电启停 (2E 21 01)" Margin="0,4"/>
        <Separator Margin="0,12"/>
        <TextBlock Text="状态" FontWeight="Bold"/>
        <TextBlock x:Name="TxtState" Text="就绪" Foreground="#8CF" FontSize="18" Margin="0,4"/>
      </StackPanel>
    </Border>

    <!-- 日志 -->
    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Background="#121212" CornerRadius="6" Padding="8">
      <ListBox x:Name="LstLog" Background="#121212" Foreground="#CFC" FontFamily="Consolas"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               BorderThickness="0"/>
    </Border>

    <!-- 结果 -->
    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Background="#2A2A2A" CornerRadius="6" Padding="12" Margin="8,0,0,8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="测试结果" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
        <Button x:Name="BtnStart" DockPanel.Dock="Bottom" Content="开 始 测 试" Height="48"
                FontSize="18" FontWeight="Bold" Background="#2E7D32" Foreground="White"
                Click="OnStart" Margin="0,12,0,0"/>
        <Button x:Name="BtnStop" DockPanel.Dock="Bottom" Content="停 止" Height="32"
                Background="#C62828" Foreground="White" Click="OnStop" Margin="0,8,0,0"
                IsEnabled="False"/>
        <ListBox x:Name="LstResult" Background="#1E1E1E" Foreground="#EEE" BorderThickness="0"/>
      </DockPanel>
    </Border>

    <!-- 底栏 -->
    <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="QiChargerStationTool · ZQWL-CANFD 250k ext · UDS 0x18DA0D03/0x18DA030D"
               Foreground="#888" Margin="0,8,0,0"/>
  </Grid>
</Window>
