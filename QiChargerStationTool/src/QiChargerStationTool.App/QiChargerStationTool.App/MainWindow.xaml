<Window x:Class="QiChargerStationTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Qi 充电模块 · 产线测试上位机" Height="720" Width="1100"
        Background="#F5F7FA" Foreground="#1A1A1A"
        FontFamily="Microsoft YaHei UI" FontSize="13">
  <Window.Resources>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="4,3"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="BorderBrush" Value="#B0B8C4"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#1A1A1A"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,6"/>
      <Setter Property="Foreground" Value="#1A1A1A"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#1A1A1A"/>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#1A1A1A"/>
      <Setter Property="BorderBrush" Value="#C5CDD8"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#D5DCE6"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
  </Window.Resources>

  <Grid Margin="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="320"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="280"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 连接配置 -->
    <Border Grid.Row="0" Grid.Column="0" CornerRadius="6" Padding="12" Margin="0,0,8,8">
      <StackPanel>
        <TextBlock Text="连接" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" Foreground="#0D47A1"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition/><RowDefinition/><RowDefinition/>
          </Grid.RowDefinitions>
          <TextBlock Text="COM 口" VerticalAlignment="Center"/>
          <TextBox x:Name="TxtPort" Grid.Column="1" Text="COM9"/>
          <TextBlock Text="波特率" Grid.Row="1" VerticalAlignment="Center"/>
          <TextBox x:Name="TxtBaud" Grid.Row="1" Grid.Column="1" Text="2000000"/>
          <TextBlock Text="固件路径" Grid.Row="2" VerticalAlignment="Center"/>
          <TextBox x:Name="TxtFirmware" Grid.Row="2" Grid.Column="1" Text="firmware/app_image.bin"/>
        </Grid>
      </StackPanel>
    </Border>

    <!-- SN 读写 / 扫码区 -->
    <Border Grid.Row="1" Grid.Column="0" CornerRadius="6" Padding="12" Margin="0,0,8,8"
            BorderBrush="#90CAF9" BorderThickness="2">
      <StackPanel>
        <TextBlock Text="SN 读写 / 扫码" FontSize="16" FontWeight="Bold" Margin="0,0,0,4" Foreground="#0D47A1"/>
        <TextBlock Text="光标停在输入框时，扫码枪扫码即自动填入；也可手动键盘输入"
                   Foreground="#5A6572" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"/>
        <TextBox x:Name="TxtSn" FontSize="22" FontWeight="Bold" Height="44"
                 VerticalContentAlignment="Center" Padding="8,4"
                 BorderBrush="#1976D2" BorderThickness="2"
                 Background="#E3F2FD" Foreground="#0D47A1"
                 AcceptsReturn="False" AcceptsTab="False"
                 KeyDown="OnSnKeyDown" GotFocus="OnSnGotFocus"
                 ToolTip="光标所在处即扫码枪输入位置（支持回车确认）"/>
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="BtnSnRead" Content="读 取" Height="36" Background="#1976D2"
                  Click="OnSnRead" ToolTip="从设备读 SN 填入输入框"/>
          <Button x:Name="BtnSnWrite" Grid.Column="1" Content="写 入" Height="36"
                  Background="#2E7D32" Click="OnSnWrite" Margin="8,0"
                  ToolTip="把输入框内容写入设备 SN"/>
          <Button Grid.Column="2" Content="清空" Width="56" Height="36"
                  Background="#78909C" Click="OnSnClear"/>
        </Grid>
        <TextBlock x:Name="TxtSnHint" Margin="0,8,0,0" Foreground="#5A6572"
                   FontSize="11" TextWrapping="Wrap" MinHeight="16"/>

        <Separator Margin="0,12,0,8"/>
        <TextBlock Text="测试项（整机流程）" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" Foreground="#0D47A1"/>
        <CheckBox x:Name="ChkVersion" Content="读软件版本 (0xF195)" IsChecked="True"/>
        <CheckBox x:Name="ChkReadSn" Content="读 SN (0xF18C)"/>
        <CheckBox x:Name="ChkWriteSn" Content="写 SN (输入框值)"/>
        <CheckBox x:Name="ChkOta" Content="OTA 升级 (31/34/36/37)"/>
        <CheckBox x:Name="ChkCharge" Content="充电启停 (2E 21 01)"/>
        <Separator Margin="0,12"/>
        <TextBlock Text="状态" FontWeight="Bold"/>
        <TextBlock x:Name="TxtState" Text="就绪" Foreground="#1565C0" FontSize="22" FontWeight="Bold" Margin="0,4"/>
      </StackPanel>
    </Border>

    <!-- 日志 -->
    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" CornerRadius="6" Padding="8">
      <ListBox x:Name="LstLog" FontFamily="Consolas" FontSize="12"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               BorderThickness="0" Background="White" Foreground="#222"/>
    </Border>

    <!-- 结果 -->
    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" CornerRadius="6" Padding="12" Margin="8,0,0,8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="测试结果" FontSize="16" FontWeight="Bold"
                   Margin="0,0,0,8" Foreground="#0D47A1"/>
        <Button x:Name="BtnStart" DockPanel.Dock="Bottom" Content="开 始 测 试" Height="48"
                FontSize="18" FontWeight="Bold" Background="#2E7D32"
                Click="OnStart" Margin="0,12,0,0"/>
        <Button x:Name="BtnStop" DockPanel.Dock="Bottom" Content="停 止" Height="32"
                Background="#C62828" Click="OnStop" Margin="0,8,0,0" IsEnabled="False"/>
        <ListBox x:Name="LstResult" BorderThickness="0" Background="White" Foreground="#1A1A1A"/>
      </DockPanel>
    </Border>

    <!-- 底栏 -->
    <TextBlock Grid.Row="2" Grid.ColumnSpan="3"
               Text="QiChargerStationTool · ZQWL-CANFD 250k ext · UDS 0x18DA0D03 / 0x18DA030D"
               Foreground="#5A6572" Margin="0,8,0,0"/>
  </Grid>
</Window>
