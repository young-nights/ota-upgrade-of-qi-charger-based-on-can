<Window x:Class="QiChargerStationTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Qi 充电模块 · 产线测试上位机" Height="760" Width="1180"
        Background="#F5F7FA" Foreground="#1A1A1A"
        FontFamily="Microsoft YaHei UI" FontSize="13">
  <Window.Resources>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="4,3"/>
      <Setter Property="Margin" Value="2"/>
      <Setter Property="BorderBrush" Value="#B0B8C4"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#1A1A1A"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#1A1A1A"/>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#1A1A1A"/>
      <Setter Property="BorderBrush" Value="#C5CDD8"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#D5DCE6"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
  </Window.Resources>

  <Grid Margin="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="360"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="280"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 连接 -->
    <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" CornerRadius="6" Padding="10" Margin="0,0,8,8">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="COM" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <TextBox x:Name="TxtPort" Width="90" Text="COM9" VerticalContentAlignment="Center"/>
        <TextBlock Text="波特率" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,4,0"/>
        <TextBox x:Name="TxtBaud" Width="100" Text="2000000" VerticalContentAlignment="Center"/>
        <TextBlock Text="固件" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,4,0"/>
        <TextBox x:Name="TxtFirmware" Width="280" Text="firmware/app_image.bin" VerticalContentAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- SN 读写 / 扫码 -->
    <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" CornerRadius="6" Padding="12" Margin="0,0,8,8"
            BorderBrush="#90CAF9" BorderThickness="2">
      <StackPanel>
        <TextBlock Text="SN 读写 / 扫码" FontSize="16" FontWeight="Bold" Foreground="#0D47A1"/>
        <TextBlock Text="光标在输入框时，扫码枪扫码即自动填入（也可手动输入）"
                   Foreground="#5A6572" FontSize="11" Margin="0,2,0,8" TextWrapping="Wrap"/>
        <TextBox x:Name="TxtSn" FontSize="22" FontWeight="Bold" Height="46"
                 VerticalContentAlignment="Center" Padding="8,4" Margin="0"
                 BorderBrush="#1976D2" BorderThickness="2"
                 Background="#E3F2FD" Foreground="#0D47A1"
                 AcceptsReturn="False" KeyDown="OnSnKeyDown" GotFocus="OnSnGotFocus"/>
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="BtnSnRead" Content="读 取" Height="38" Background="#1976D2"
                  Click="OnSnRead" Margin="0,0,4,0" ToolTip="从设备读 SN 到输入框"/>
          <Button x:Name="BtnSnWrite" Grid.Column="1" Content="写 入" Height="38"
                  Background="#2E7D32" Click="OnSnWrite" Margin="4,0"
                  ToolTip="把输入框 SN 写入设备并读回校验"/>
          <Button Grid.Column="2" Content="清空" Width="58" Height="38"
                  Background="#78909C" Click="OnSnClear" Margin="4,0,0,0"/>
        </Grid>
        <TextBlock x:Name="TxtSnHint" Margin="0,10,0,0" Foreground="#5A6572"
                   FontSize="11" TextWrapping="Wrap" MinHeight="18"/>

        <Separator Margin="0,16,0,12"/>
        <TextBlock Text="状态" FontWeight="Bold"/>
        <TextBlock x:Name="TxtState" Text="就绪" Foreground="#1565C0"
                   FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
        <TextBlock x:Name="TxtStateDetail" Foreground="#5A6572" FontSize="11"
                   TextWrapping="Wrap" Margin="0,4,0,0"/>
      </StackPanel>
    </Border>

    <!-- 测试操作按钮 -->
    <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" CornerRadius="6" Padding="14" Margin="8,0,0,8">
      <StackPanel>
        <TextBlock Text="测试操作" FontSize="16" FontWeight="Bold" Foreground="#0D47A1" Margin="0,0,0,10"/>
        <UniformGrid Columns="3" Rows="2">
          <Button x:Name="BtnReadVersion" Content="读软件版本" Height="64" FontSize="16"
                  Background="#1565C0" Click="OnReadVersion"
                  ToolTip="22 F195 读取 APP 版本"/>
          <Button x:Name="BtnOta" Content="OTA 升级" Height="64" FontSize="16"
                  Background="#6A1B9A" Click="OnOtaUpgrade"
                  ToolTip="MCU1 APP：10 02 → SA → 31 擦除 → 34/36/37"/>
          <Button x:Name="BtnIap" Content="IAP 升级" Height="64" FontSize="16"
                  Background="#EF6C00" Click="OnIapUpgrade"
                  ToolTip="Qi 芯片 MCU2：2E 20 10 04 → 31/34/36/37"/>
          <Button x:Name="BtnChargeOn" Content="开启充电" Height="64" FontSize="16"
                  Background="#2E7D32" Click="OnChargeOn"
                  ToolTip="2E 21 01 01"/>
          <Button x:Name="BtnChargeOff" Content="关闭充电" Height="64" FontSize="16"
                  Background="#C62828" Click="OnChargeOff"
                  ToolTip="2E 21 01 00"/>
          <Button x:Name="BtnStop" Content="停 止" Height="64" FontSize="16"
                  Background="#455A64" Click="OnStop" IsEnabled="False"/>
        </UniformGrid>
      </StackPanel>
    </Border>

    <!-- 日志 -->
    <Border Grid.Row="2" Grid.Column="1" CornerRadius="6" Padding="8" Margin="8,0,8,8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="运行日志" FontWeight="Bold"
                   Foreground="#0D47A1" Margin="2,0,0,6"/>
        <ListBox x:Name="LstLog" FontFamily="Consolas" FontSize="12"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 BorderThickness="0" Background="White" Foreground="#222"/>
      </DockPanel>
    </Border>

    <!-- 操作记录 -->
    <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" CornerRadius="6" Padding="12" Margin="8,0,0,8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="操作记录" FontSize="16" FontWeight="Bold"
                   Foreground="#0D47A1" Margin="0,0,0,8"/>
        <Button x:Name="BtnClearResult" DockPanel.Dock="Bottom" Content="清空记录"
                Height="32" Background="#78909C" Click="OnClearResult" Margin="0,10,0,0"/>
        <ListBox x:Name="LstResult" BorderThickness="0" Background="White" Foreground="#1A1A1A"/>
      </DockPanel>
    </Border>

    <!-- 底栏 -->
    <TextBlock Grid.Row="3" Grid.ColumnSpan="3"
               Text="QiChargerStationTool · ZQWL-CANFD 250k ext · UDS 0x18DA0D03 / 0x18DA030D"
               Foreground="#5A6572" Margin="0,6,0,0"/>
  </Grid>
</Window>
