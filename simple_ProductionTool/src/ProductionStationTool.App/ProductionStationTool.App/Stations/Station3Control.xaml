<UserControl x:Class="ProductionStationTool.App.Stations.Station3Control"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ProductionStationTool.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*" MinHeight="220"/>
        </Grid.RowDefinitions>

        <!-- ① 串口接入区 -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <controls:ConnectionPanel x:Name="ConnPanel"/>
        </Border>

        <!-- ② 流程区 + ③ 数据展示区 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="5*"/>
            </Grid.ColumnDefinitions>

            <!-- 流程区 -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="测试流程" Style="{StaticResource SectionTitle}"/>
                        <Button Content="日志" Style="{StaticResource GhostButton}"
                                Height="26" Padding="12,0" HorizontalAlignment="Right"
                                Click="BtnLog_Click"
                                ToolTip="弹出运行日志窗口（不占主页面）"/>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <controls:FlowStepsPanel x:Name="FlowPanel"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 数据展示区：结果/SN/版本比对三列一行，异常项列表占满剩余行 -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- 结果/SN 一行；线圈上下排 + 版本比对一行吃满剩余空间（异常项栏已撤） -->
                        <RowDefinition Height="*" MinHeight="90"/>
                        <RowDefinition Height="*" MinHeight="230"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="数据展示" Style="{StaticResource SectionTitle}"
                               Margin="0,0,0,4"/>

                    <!-- 结果大字 + SN 码 并排（SN 占半幅，长码显示完整） -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="BadgeResult" Grid.Column="0" Background="#F1F5F9" CornerRadius="8"
                                Padding="24,14" VerticalAlignment="Stretch">
                            <TextBlock x:Name="TxtResult" Text="待测试" FontSize="40"
                                       FontWeight="Bold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>
                        <Border Grid.Column="2" Background="{StaticResource FieldBgBrush}"
                                CornerRadius="8" Padding="14">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="SN 码（设备读取）" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="TxtSn" Text="—"
                                           FontSize="22" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 线圈 A/B 上下排布（左侧全宽防截断） + 版本号比对（右侧） -->
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*" MinWidth="340"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <controls:CoilJudgeCard x:Name="CardCoilA" Grid.Row="0" Title="线圈 A"/>
                            <controls:CoilJudgeCard x:Name="CardCoilB" Grid.Row="2" Title="线圈 B"/>
                        </Grid>
                        <Border Grid.Column="2" Background="{StaticResource FieldBgBrush}"
                                CornerRadius="8" Padding="14,10">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="版本号比对（实测 / 预设）" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="TxtVerApp" Text="APP   —"
                                           FontSize="13" FontFamily="Consolas" Margin="0,5,0,0"
                                           TextOptions.TextFormattingMode="Display" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="TxtVerBoot" Text="Boot  —"
                                           FontSize="13" FontFamily="Consolas" Margin="0,5,0,0"
                                           TextOptions.TextFormattingMode="Display" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="TxtVerQi" Text="Qi    —"
                                           FontSize="13" FontFamily="Consolas" Margin="0,5,0,0"
                                           TextOptions.TextFormattingMode="Display" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="TxtVerHw" Text="硬件  —"
                                           FontSize="13" FontFamily="Consolas" Margin="0,5,0,0"
                                           TextOptions.TextFormattingMode="Display" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
