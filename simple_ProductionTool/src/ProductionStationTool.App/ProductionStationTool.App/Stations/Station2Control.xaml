<UserControl x:Class="ProductionStationTool.App.Stations.Station2Control"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ProductionStationTool.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ① 串口接入区（仅 CAN，开充指令不需 PowerZ） -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <controls:ConnectionPanel x:Name="ConnPanel"/>
        </Border>

        <!-- ② 开充循环状态（简化老化位：无倒计时/测流/入库） -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="开充循环（老化位）" Style="{StaticResource SectionTitle}"/>
                    <Button Content="日志" Style="{StaticResource GhostButton}"
                            Height="26" Padding="12,0" HorizontalAlignment="Right"
                            Click="BtnLog_Click"
                            ToolTip="弹出运行日志窗口（不占主页面）"/>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 状态大字 -->
                        <Border x:Name="BadgeState" Background="#F1F5F9" CornerRadius="8"
                                Padding="24,12" Margin="0,0,0,16" HorizontalAlignment="Left">
                            <TextBlock x:Name="TxtState" Text="未启动" FontSize="40"
                                       FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>

                        <!-- 发送计数 / 最近结果 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="1.6*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource FieldBgBrush}"
                                    CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="已发送" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="TxtCount" Text="0 次"
                                               FontSize="32" FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{StaticResource FieldBgBrush}"
                                    CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="最近发送" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="TxtLast" Text="—"
                                               FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 使用提示 -->
                        <TextBlock x:Name="TxtHint"
                                   Text="点击「开始测试」后以 500ms 周期持续发送开充指令（2E 21 01）；产线接新设备无需重新点击，「断开」停止循环。不倒计时、不读电流电压、不判限、不入库。"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
