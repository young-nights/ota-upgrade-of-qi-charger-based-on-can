<UserControl x:Class="ProductionStationTool.App.Stations.Station1Control"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ProductionStationTool.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*" MinHeight="220"/>
        </Grid.RowDefinitions>

        <!-- ① 串口接入区 -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <controls:ConnectionPanel x:Name="ConnPanel"/>
        </Border>

        <!-- ② 流程区 + ③ 数据展示区 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="5*"/>
            </Grid.ColumnDefinitions>

            <!-- 流程区 -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="测试流程" Style="{StaticResource SectionTitle}"/>
                        <Button Content="日志" Style="{StaticResource GhostButton}"
                                Height="26" Padding="12,0" HorizontalAlignment="Right"
                                Click="BtnLog_Click"
                                ToolTip="弹出运行日志窗口（不占主页面）"/>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <controls:FlowStepsPanel x:Name="FlowPanel"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 数据展示区：结果 + 线圈 A/B，异常项列表占满剩余行 -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- 结果/SN 与 A/B 线圈吃掉剩余空间（等比放大）；
                             异常项列表固定高，不随窗口变大 -->
                        <RowDefinition Height="*" MinHeight="90"/>
                        <RowDefinition Height="*" MinHeight="105"/>
                        <RowDefinition Height="Auto"/>
                        <!-- 异常项列表：至少 80，保证失败原因完整显示 -->
                        <RowDefinition Height="80"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="数据展示" Style="{StaticResource SectionTitle}"
                               Margin="0,0,0,4"/>

                    <!-- 软硬件版本 + 线圈换接提示 -->
                    <TextBlock x:Name="TxtVersion" Grid.Row="0" Text=""
                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Top"
                               TextWrapping="Wrap" MaxWidth="420" Margin="0,0,0,0"/>
                    <TextBlock x:Name="TxtCoilHint" Grid.Row="0" Text=""
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom"
                               Margin="0,0,0,2"/>

                    <!-- 结果大字（简化流程：无 SN、无数据库关联） -->
                    <Border x:Name="BadgeResult" Grid.Row="1" Background="#F1F5F9" CornerRadius="8"
                            Padding="24,14" Margin="0,0,0,12" HorizontalAlignment="Left">
                        <TextBlock x:Name="TxtResult" Text="待测试" FontSize="40"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>

                    <!-- 线圈 A/B 一行 -->
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <controls:CoilJudgeCard x:Name="CardCoilA" Grid.Column="0" Title="线圈 A"/>
                        <controls:CoilJudgeCard x:Name="CardCoilB" Grid.Column="2" Title="线圈 B"/>
                    </Grid>

                    <!-- 异常项 -->
                    <TextBlock Grid.Row="3" Text="异常项" Style="{StaticResource SectionTitle}"
                               Margin="0,0,0,4"/>
                    <ListBox x:Name="ListAbnormal" Grid.Row="4" FontSize="14"
                             Background="{StaticResource FieldBgBrush}"
                             BorderBrush="{StaticResource CardBorderBrush}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
