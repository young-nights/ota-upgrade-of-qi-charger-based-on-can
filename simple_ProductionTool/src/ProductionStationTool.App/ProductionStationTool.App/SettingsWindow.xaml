<Window x:Class="ProductionStationTool.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="本机设置" Height="720" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">
    <TabControl x:Name="Tabs" Margin="16" Background="Transparent" BorderThickness="0">

        <!-- 页 1：机位设置 -->
        <TabItem Header="机位设置">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="本机身份（机位命名）" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="TxtCurrentCode" Text="当前编码：ST-01-1"
                                       FontSize="22" FontWeight="Bold" Margin="0,10,0,2"
                                       Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="机位数随产量动态增减：改名只写 machine.json，代码零改动；保存后重启软件生效。"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="工位号" Style="{StaticResource FieldLabel}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="CmbStationNo" Grid.Column="1" Style="{StaticResource FieldComboEditable}"
                                          IsEditable="True" SelectionChanged="Identity_Changed">
                                    <ComboBoxItem Content="1"/>
                                    <ComboBoxItem Content="3"/>
                                </ComboBox>
                                <TextBlock Grid.Column="3" Text="机位号" Style="{StaticResource FieldLabel}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtMachineId" Grid.Column="4" Style="{StaticResource FieldBox}"
                                         TextChanged="Identity_Changed"/>
                            </Grid>
                            <TextBlock Text="机位号 1~8 位字母/数字，同工位内不重复（如 1、2、3…）"
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                            <WrapPanel>
                                <Button Content="保存机位设置" Width="150" Height="40"
                                        Style="{StaticResource PrimaryButton}" Click="BtnSave_Click"/>
                                <TextBlock x:Name="TxtSaveResult" VerticalAlignment="Center"
                                           Margin="12,0,0,0" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="变更记录（machine_change.log）" Style="{StaticResource SectionTitle}"/>
                            <TextBox x:Name="TxtLog" IsReadOnly="True" AcceptsReturn="True"
                                     TextWrapping="Wrap" Height="110" Margin="0,10,0,0"
                                     FontSize="11" FontFamily="Consolas"
                                     Background="{StaticResource FieldBgBrush}"
                                     BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- 页 2：检测参数 -->
        <TabItem Header="检测参数">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="步骤 5 双线圈检测参数" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="A 线圈：采集窗口内均值电流落在 [A 下限, A 上限] 区间内即正常（低于下限=低流、高于上限=过流，均异常）；A 通过后实时监测跌落（低于 B 下限或 A 均值一半），跌落状态持续「跌落确认」时长才算有效换线圈（不判失败）；B 线圈：电流恢复进入 [B 下限, B 上限] 区间并持续规定时长即正常；整体超时（A 采集 + 换线圈 + B 判定）判 FAIL。保存后下次测试生效。"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,10,0,12"/>

                            <UniformGrid Columns="3">
                                <StackPanel Margin="0,0,8,0"
                                            ToolTip="A 下限：A 线圈均值电流低于此值判低流异常（默认 1.0A）">
                                    <TextBlock Text="A 下限 (A)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="BoxALower" Style="{StaticResource FieldBox}" Text="1.0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0"
                                            ToolTip="A 上限：A 线圈均值电流高于此值判过流异常（默认 2.0A）">
                                    <TextBlock Text="A 上限 (A)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="BoxAUpper" Style="{StaticResource FieldBox}" Text="2.0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0"
                                            ToolTip="B 下限：B 线圈恢复判定区间下沿（默认 1.0A）">
                                    <TextBlock Text="B 下限 (A)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="BoxBLower" Style="{StaticResource FieldBox}" Text="1.0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0"
                                            ToolTip="B 上限：B 线圈恢复判定区间上沿（默认 2.0A）">
                                    <TextBlock Text="B 上限 (A)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="BoxBUpper" Style="{StaticResource FieldBox}" Text="2.0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0"
                                            ToolTip="A 窗口：A 线圈固定采集时长（秒）。窗口内电流均值落在 A 上下限区间内即判 A 通过（默认 10s）">
                                    <TextBlock Text="A 窗口 (s)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="BoxAWindowSec" Style="{StaticResource FieldBox}" Text="10"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0"
                                            ToolTip="B 持续：B 线圈电流恢复进 B 上下限区间后，须连续保持在区间内该时长（秒）才判 B 通过（默认 3s）">
                                    <TextBlock Text="B 持续 (s)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="BoxBSustainSec" Style="{StaticResource FieldBox}" Text="3"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0"
                                            ToolTip="跌落确认：A 通过后电流处于跌落状态（低于 B 下限或 A 均值一半）须持续该时长（秒）才算有效换线圈，抗毛刺干扰（默认 2s）">
                                    <TextBlock Text="跌落确认 (s)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="BoxTransitionSec" Style="{StaticResource FieldBox}" Text="2"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0"
                                            ToolTip="采样间隔：PowerZ 启动帧重发节奏（毫秒），决定采样频率 ≈ 1000/间隔 Hz。默认 200ms ≈ 5Hz；范围 50~5000">
                                    <TextBlock Text="采样间隔 (ms)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="BoxSampleIntervalMs" Style="{StaticResource FieldBox}" Text="200"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="整体超时 (s)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="BoxTimeoutSec" Style="{StaticResource FieldBox}" Text="60"/>
                                </StackPanel>
                            </UniformGrid>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="保存检测参数" Width="150" Height="40"
                                        Style="{StaticResource PrimaryButton}" Click="BtnSaveCoil_Click"/>
                                <Button Content="恢复默认" Width="110" Height="40" Margin="12,0,0,0"
                                        Style="{StaticResource GhostButton}" Click="BtnCoilDefaults_Click"/>
                                <TextBlock x:Name="TxtCoilSaveResult" VerticalAlignment="Center"
                                           Margin="12,0,0,0" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="扫码参数" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="点击「开始测试」后进入等待扫码。输入框每收到一次键入都会重新计时；超时后校验当前内容，SN 结构不符合则本次 FAIL。扫码枪回车会立即确认。"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,10,0,12"/>
                            <WrapPanel>
                                <StackPanel Width="140" Margin="0,0,12,0">
                                    <TextBlock Text="扫码超时 (s)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="BoxScanTimeoutSec" Style="{StaticResource FieldBox}" Text="10"/>
                                </StackPanel>
                                <StackPanel Width="160" Margin="0,0,12,0">
                                    <TextBlock Text="SN码判定超时 (s)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="BoxSnJudgeTimeoutSec" Style="{StaticResource FieldBox}" Text="2"/>
                                </StackPanel>
                                <StackPanel Width="140" Margin="0,0,12,0">
                                    <TextBlock Text="整体超时 (s)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="BoxOverallTimeoutSec" Style="{StaticResource FieldBox}" Text="15"/>
                                </StackPanel>
                                <Button Content="保存扫码参数" Width="150" Height="40"
                                        VerticalAlignment="Bottom"
                                        Style="{StaticResource PrimaryButton}" Click="BtnSaveScan_Click"/>
                                <TextBlock x:Name="TxtScanSaveResult" VerticalAlignment="Center"
                                           Margin="12,0,0,0" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <!-- ===== 页 3：版本预设（版本比对基准） ===== -->
        <TabItem Header="版本预设">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="版本比对预设" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="工位「比对版本号」步骤把设备版本与这里比对：APP / Boot / Qi / 硬件 四项，凡填了预设的项逐一核对（全串或版本尾缀均可，如 QC_JYF_MCU2_FW_1.2.3 可只填 1.2.3）；留空 = 不比该项。保存后下次测试生效。"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,10,0,12"/>

                            <TextBlock Text="APP 版本" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                            <!-- Display 模式像素对齐：ClearType 亚像素定位会把 _ 细线按串宽抹平（实测 APP 示例下划线消失、Boot 正常） -->
                            <TextBlock FontFamily="Consolas" FontSize="12" Foreground="#334155"
                                       TextOptions.TextFormattingMode="Display"
                                       Padding="0,0,0,3" Margin="0,0,0,4"
                                       Text="格式如 QC_JYF_MCU1_FW_1.2.1"/>
                            <TextBox x:Name="BoxPresetApp" Style="{StaticResource FieldBox}" Margin="0,0,0,12"/>

                            <TextBlock Text="Boot 版本" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                            <!-- Display 模式像素对齐：ClearType 亚像素定位会把 _ 细线按串宽抹平（实测 APP 示例下划线消失、Boot 正常） -->
                            <TextBlock FontFamily="Consolas" FontSize="12" Foreground="#334155"
                                       TextOptions.TextFormattingMode="Display"
                                       Padding="0,0,0,3" Margin="0,0,0,4"
                                       Text="格式如 QC_JYF_BL_1.0.0"/>
                            <TextBox x:Name="BoxPresetBoot" Style="{StaticResource FieldBox}" Margin="0,0,0,12"/>

                            <TextBlock Text="Qi 版本" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                            <!-- Display 模式像素对齐：ClearType 亚像素定位会把 _ 细线按串宽抹平（实测 APP 示例下划线消失、Boot 正常） -->
                            <TextBlock FontFamily="Consolas" FontSize="12" Foreground="#334155"
                                       TextOptions.TextFormattingMode="Display"
                                       Padding="0,0,0,3" Margin="0,0,0,4"
                                       Text="格式如 QC_JYF_MCU2_FW_1.2.3"/>
                            <TextBox x:Name="BoxPresetQi" Style="{StaticResource FieldBox}" Margin="0,0,0,12"/>

                            <TextBlock Text="硬件版本" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                            <!-- Display 模式像素对齐：ClearType 亚像素定位会把 _ 细线按串宽抹平（实测 APP 示例下划线消失、Boot 正常） -->
                            <TextBlock FontFamily="Consolas" FontSize="12" Foreground="#334155"
                                       TextOptions.TextFormattingMode="Display"
                                       Padding="0,0,0,3" Margin="0,0,0,4"
                                       Text="格式如 QC_JYF_HW_1.1.5"/>
                            <TextBox x:Name="BoxPresetHw" Style="{StaticResource FieldBox}" Margin="0,0,0,12"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="保存版本预设" Width="150" Height="40"
                                        Style="{StaticResource PrimaryButton}" Click="BtnSavePresets_Click"/>
                                <TextBlock x:Name="TxtPresetResult" VerticalAlignment="Center"
                                           Margin="12,0,0,0" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
